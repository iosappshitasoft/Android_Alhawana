<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Widest, most transparent glow -->
    <item android:top="0dp" android:bottom="0dp" android:left="0dp" android:right="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp"/>
            <solid android:color="#15E040FB"/>
        </shape>
    </item>
    <!-- Medium glow -->
    <item android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="22dp"/>
            <solid android:color="#2AE040FB"/>
        </shape>
    </item>
    <!-- Core intense glow -->
    <item android:top="4dp" android:bottom="4dp" android:left="4dp" android:right="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp"/>
            <solid android:color="#55E040FB"/>
        </shape>
    </item>
</layer-list>
