<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Soft Glow Layer 1 -->
    <item android:top="15dp" android:left="5dp" android:right="5dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="270"
                android:endColor="#00832D85"
                android:startColor="#4D832D85"
                android:type="linear" />
        </shape>
    </item>
    <!-- Soft Glow Layer 2 -->
    <item android:top="20dp" android:left="10dp" android:right="10dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="270"
                android:endColor="#00832D85"
                android:startColor="#80832D85"
                android:type="linear" />
        </shape>
    </item>
    <!-- Main Button Body -->
    <item android:bottom="12dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="@color/colorPrimary" />
        </shape>
    </item>
</layer-list>
