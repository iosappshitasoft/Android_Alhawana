<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="10dp"
    android:background="@color/surface_color"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:layout_width="25dp"
        android:layout_height="5dp"
        android:background="@drawable/curved_accent"
        android:layout_gravity="center"
        android:layout_margin="10dp"
        android:alpha="0.5"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/go_live_privacy"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:layout_gravity="center"
        android:layout_marginVertical="24dp"
        android:textStyle="bold"/>

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:dividerThickness="2dp"
        app:dividerColor="#35383F"
        android:layout_marginHorizontal="24dp"/>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:shadowColor="#A6FF4D67"
        android:clickable="true"
        android:shadowDx="4"
        android:id="@+id/publicLay"
        android:shadowDy="8"
        android:background="@drawable/curved_accent"
        android:layout_marginHorizontal="24dp"
        android:backgroundTint="@color/colorPrimary"
        android:gravity="center"
        android:foreground="?selectableItemBackground"
        android:shadowRadius="24"
        android:layout_marginBottom="36dp"
        >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/public_live"
            android:textSize="16sp"
            android:letterSpacing="0.01"
            android:textColor="@color/white"
            android:layout_gravity="center"
            android:paddingVertical="16dp"
            android:textStyle="bold"/>


    </FrameLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:shadowColor="#80FF4D67"
        android:clickable="true"
        android:layout_marginBottom="36dp"
        android:shadowDx="4"
        android:id="@+id/privateLay"
        android:shadowDy="8"
        android:visibility="gone"
        android:background="@drawable/curved_accent"
        android:layout_marginHorizontal="24dp"
        android:backgroundTint="@color/white"
        android:gravity="center"
        android:foreground="?selectableItemBackground"
        android:shadowRadius="24">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/private_live"
            android:textSize="16sp"
            android:letterSpacing="0.01"
            android:textColor="@color/gradient_start"
            android:layout_gravity="center"
            android:paddingVertical="16dp"
            android:textStyle="bold"/>


    </FrameLayout>

</LinearLayout>