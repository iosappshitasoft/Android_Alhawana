<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_background_color">


    <LinearLayout
        android:id="@+id/topAddAudioPill"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_audio_pill"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        app:layout_constraintEnd_toEndOf="@+id/previewImage"
        app:layout_constraintStart_toStartOf="@+id/previewImage"
        app:layout_constraintTop_toTopOf="parent">


        <!-- Top bar: Tap to add audio pill -->
        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_next_button"
            android:contentDescription="@string/app_name"
            android:padding="2dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />



        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center"
            android:gravity="center"
            android:paddingStart="50dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgAudioArt"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_audio_pill_icon"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_music_note_white" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">
            <TextView
                android:id="@+id/txtAddAudio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tap_to_add_audio"
                android:textColor="@color/colorWhite"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtAudioSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/suggested_audio"
                android:textColor="@color/secondarytext"
                android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/btnAddAudio"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_next_button"
            android:src="@android:drawable/ic_input_add"
            app:tint="@color/colorWhite" />
    </LinearLayout>

    <!-- Main preview area -->
    <ImageView
        android:id="@+id/previewImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="10dp"
        android:background="@color/colorBlackLt"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter"
        android:src="@mipmap/app_icon_new"
        app:layout_constraintBottom_toTopOf="@+id/rvThumbs"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topAddAudioPill" />

    <!-- Bottom left thumbnail tray (single item for now) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvThumbs"
        android:layout_width="0dp"
        android:layout_height="96dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toTopOf="@+id/btnNext"
        app:layout_constraintEnd_toStartOf="@id/rightCol"
        app:layout_constraintStart_toStartOf="@+id/previewImage" />

    <!-- Right side add and counter -->
    <LinearLayout
        android:id="@+id/rightCol"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/btnNext"
        app:layout_constraintEnd_toEndOf="@+id/previewImage"
        app:layout_constraintTop_toTopOf="@+id/rvThumbs">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnAdd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@android:drawable/ic_input_add"
            app:backgroundTint="@color/colorPrimary"
            app:tint="@color/colorWhite" />

        <TextView
            android:id="@+id/txtCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="0/35"
            android:textColor="@color/colorWhite"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Bottom toolbar -->

    <!-- Next button -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="wrap_content"
        android:layout_height="96dp"
        android:layout_margin="16dp"
        android:visibility="gone"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.043"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/btnMusic"
            android:layout_width="60dp"
            android:layout_height="65dp"
            android:background="@drawable/bg_bottom_chip"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="10dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/iconMusic"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/music"
                app:tint="@color/colorWhite" />

            <TextView
                android:id="@+id/textMusic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/music"
                android:textColor="@color/colorWhite"
                android:textSize="10sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnOverlay"
            android:layout_width="60dp"
            android:layout_height="65dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_bottom_chip"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="10dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/iconOverlay"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/galary2"
                app:tint="@color/colorWhite" />

            <TextView
                android:id="@+id/textOverlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/overlay"
                android:textColor="@color/colorWhite"
                android:textSize="10sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnCamera"
            android:layout_width="60dp"
            android:layout_height="65dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_bottom_chip"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="10dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/iconCamera"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/camera2"
                app:tint="@color/colorWhite" />

            <TextView
                android:id="@+id/textCamera"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/camera"
                android:textColor="@color/colorWhite"
                android:textSize="10sp"/>
        </LinearLayout>




    </LinearLayout>

    <Button
        android:id="@+id/btnNext"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_next_button"
        android:text="@string/next"
        android:textAllCaps="false"
        android:textColor="@color/colorWhite"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/rightCol"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/rvThumbs" />

</androidx.constraintlayout.widget.ConstraintLayout>
