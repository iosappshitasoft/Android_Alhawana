<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/itemLay"
    android:layout_width="match_parent"
    android:layout_height="95dp"
    android:layout_centerInParent="true"
    android:layout_gravity="center"
    android:padding="5dp"
    android:layout_margin="5dp"
    android:background="@drawable/bg_gift_background">

    <RelativeLayout
        android:id="@+id/selectionBackgroundLay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center">

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:indeterminate="true" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:orientation="vertical">


            <ImageView
                android:id="@+id/giftImage"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:src="@drawable/gift_primary"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/txtGiftName"
                android:textFontWeight="500"
                style="@style/OutfitRegularForHeadingLiteWhiteSize10"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:layout_gravity="center"
                />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="center"
                android:gravity="center"
                android:layout_marginTop="3dp"
                android:visibility="visible">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_gravity="center"
                    android:src="@drawable/diamond_blue"
                    android:visibility="visible"/>

                <TextView
                    android:id="@+id/txtGiftPrice"
                    style="@style/OutfitRegularForHeadingLiteWhiteSize10"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="5dp"
                    android:textColor="@color/colorWhite"
                    android:gravity="center_vertical"
                    android:text="hsdhasd" />

            </LinearLayout>

            <TextView
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:text="@string/text_send_new"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="4dp"
                android:textColor="@color/white"
                android:background="@drawable/mls_bg_gray"
                android:id="@+id/txt_send_gft"
                android:textSize="@dimen/text_small"
                android:visibility="gone"/>


        </LinearLayout>

    </RelativeLayout>

</RelativeLayout>