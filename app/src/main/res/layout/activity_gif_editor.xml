<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/StyleRoot"
    android:background="#050505"
    tools:context=".GifEditorActivity">


  <androidx.cardview.widget.CardView
      android:layout_width="0dp"
      android:layout_height="0dp"
      app:cardCornerRadius="32dp"
      app:cardElevation="0dp"
      android:layout_marginTop="32dp"
      android:background="#050505"
      android:layout_marginBottom="12dp"
      android:layout_marginStart="16dp"
      android:layout_marginEnd="16dp"
      app:layout_constraintTop_toBottomOf="@+id/topBar"
      app:layout_constraintBottom_toTopOf="@+id/controlsLay"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent">

    <!--        <com.google.android.exoplayer2.ui.StyledPlayerView-->
    <!--            android:id="@+id/player_view_lib"-->
    <!--            android:layout_width="match_parent"-->
    <!--            android:layout_height="match_parent"-->
    <!--            android:background="@color/colorBlack"-->
    <!--            android:clipToOutline="true"-->
    <!--            app:resize_mode="fill"-->
    <!--            app:use_controller="false" />-->

    <!-- ✅ FrameLayout helps stack player and progress bar -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

      <com.google.android.exoplayer2.ui.StyledPlayerView
          android:id="@+id/player_view_lib"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:background="@color/colorBlack"
          android:clipToOutline="true"
          app:resize_mode="fill"
          app:use_controller="false" />
      <ImageView
          android:id="@+id/image_play_pause"
          style="@style/WView"
          android:layout_width="48dp"
          android:background="@drawable/shape_circle_lib"
          android:src="@drawable/ic_video_play_lib"
          android:layout_height="48dp"
          android:layout_gravity="center" />


    </FrameLayout>
  </androidx.cardview.widget.CardView>


  <!--    <ImageView-->
  <!--        android:id="@+id/image_play_pause"-->
  <!--        style="@style/WView"-->
  <!--        android:layout_centerInParent="true"-->
  <!--        android:background="@drawable/shape_circle_lib"-->
  <!--        android:padding="12dp"-->
  <!--        android:src="@drawable/ic_video_play_lib"-->
  <!--        android:visibility="gone"-->
  <!--        app:layout_constraintBottom_toBottomOf="parent"-->
  <!--        app:layout_constraintEnd_toEndOf="parent"-->
  <!--        app:layout_constraintStart_toStartOf="parent"-->
  <!--        app:layout_constraintTop_toTopOf="parent" />-->

  <ProgressBar
      android:id="@+id/progress_circular"
      style="@style/WView"
      android:layout_centerInParent="true"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent" />

  <SeekBar
      android:id="@+id/simpleSeekbar"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:max="1000"
      android:padding="8dp"
      android:progress="0"
      android:thumbTint="@color/colorWhite"
      android:progressTint="@color/colorPrimary"
      android:visibility="gone"
      app:layout_constraintBottom_toBottomOf="parent"/>
<!--  <com.iammert.rangeview.library.RangeView
      android:id="@+id/rangeSeekBar"
      android:layout_width="match_parent"
      android:layout_height="70dp"
      app:layout_constraintBottom_toBottomOf="parent"
      android:layout_margin="8dp"/>-->
  <LinearLayout
      android:id="@+id/controlsLay"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="25dp"
      android:layout_marginStart="16dp"
      android:layout_marginEnd="16dp"
      android:orientation="vertical"
      app:layout_constraintBottom_toBottomOf="parent">

    <com.crystal.crystalrangeseekbar.widgets.CrystalRangeSeekbar
        android:id="@+id/trimRange"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="60dp"/>

    <include
        android:id="@+id/videoController"
        layout="@layout/view_video_controller"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom" />

    <Button
        android:id="@+id/btnNext"
        style="@style/ButtonPrimaryBold1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="0dp"
        android:fontFamily="@font/outfit_regular"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/next"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:textSize="16sp"
        android:visibility="gone"
        android:textAllCaps="false"
        android:textColor="@color/colorWhite"
        android:backgroundTint="@color/colorPrimary"
        />

  </LinearLayout>

  <FrameLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginHorizontal="16dp"
      android:layout_marginVertical="15dp"
      android:id="@+id/topBar"
      app:layout_constraintTop_toTopOf="parent">

    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_centerVertical="true"
        android:layout_gravity="start"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:src="@drawable/camera_close_svg"
        android:visibility="visible" />

    <LinearLayout
        android:id="@+id/generateLay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:gravity="center"
        android:background="@drawable/bg_primary_curved"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">


      <com.app.helper.LinkEllipseTextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="center"

          android:singleLine="true"
          android:text="@string/generate"
          android:fontFamily="@font/outfit_medium"
          android:layout_marginStart="8dp"
          android:id="@+id/txtSound"
          android:textColor="@color/colorWhite"
          android:textSize="14sp" />

    </LinearLayout>

  </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>