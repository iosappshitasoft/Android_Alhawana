<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:padding="8dp"
    android:background="@drawable/bg_card_curve"
    android:layout_height="wrap_content">

    <com.makeramen.roundedimageview.RoundedImageView
        android:id="@+id/profileImage"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:adjustViewBounds="true"
        android:scaleType="centerCrop"
        android:layout_margin="5dp"
        android:src="@drawable/loginscreen_bg"
        app:riv_mutate_background="true"
        app:riv_oval="true" />

    <LinearLayout
        android:id="@+id/notificationDetailLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:padding="5dp"
        android:layout_toStartOf="@+id/thumbNail"
        android:layout_toEndOf="@+id/profileImage"
        android:orientation="vertical">


        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/userName"
            style="@style/TextPrimaryRegular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:text="@string/messenger"
            android:textColor="@color/colorWhite"
            android:fontFamily="@font/outfit_medium"
            android:textSize="@dimen/text_medium" />

<!--        <com.google.android.material.textview.MaterialTextView-->
<!--            android:id="@+id/comment"-->
<!--            style="@style/TextSecondaryLight"-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:layout_gravity="start"-->
<!--            android:layout_marginTop="4dp"-->
<!--            android:layout_marginBottom="4dp"-->
<!--            android:textColor="@color/colorWhite"-->
<!--            android:fontFamily="@font/outfit_regular"-->
<!--            android:maxLines="1"-->
<!--            android:text="@string/messenger"-->
<!--            android:textAlignment="viewStart"-->
<!--            android:textSize="@dimen/text_normal" />-->

<!--        <com.google.android.material.textview.MaterialTextView-->
<!--            android:id="@+id/time"-->
<!--            style="@style/TextSecondaryLight"-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:layout_gravity="start"-->
<!--            android:maxLines="1"-->
<!--            android:textColor="@color/colorWhite"-->
<!--            android:fontFamily="@font/outfit_medium"-->
<!--            android:text="@string/messenger"-->
<!--            android:textAlignment="viewStart"-->
<!--            android:textSize="@dimen/text_normal" />-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="4dp">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/txtcomment"
                style="@style/TextSecondaryLight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#8F8F8F"
                android:fontFamily="@font/outfit_regular"
                android:text="@string/messenger"
                android:textAlignment="viewStart"
                android:textSize="@dimen/text_normal" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/time"
                style="@style/TextSecondaryLight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="#8F8F8F"
                android:fontFamily="@font/outfit_medium"
                android:text="@string/messenger"
                android:textAlignment="viewEnd"
                android:textSize="@dimen/text_normal"
                android:layout_marginStart="8dp"/>
        </LinearLayout>


    </LinearLayout>

    <com.makeramen.roundedimageview.RoundedImageView
        android:id="@+id/thumbNail"
        android:layout_width="40dp"
        android:layout_height="56dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:layout_margin="5dp"
        android:src="@drawable/video_placeholder"
        app:riv_corner_radius="2dp"
        app:riv_oval="false" />

</RelativeLayout>