<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBlack"
    android:keepScreenOn="true"
    android:layoutDirection="locale">


    <FrameLayout
        android:id="@+id/wrap_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0">

    </FrameLayout>


    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/cameraPageCloseButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:layout_marginStart="15dp"
        android:layout_marginTop="15dp"
        android:visibility="visible"
        app:srcCompat="@drawable/camera_close_svg" />


    <TextView
        android:id="@+id/textView"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_centerInParent="true"
        android:fontFamily="@font/font_regular"
        android:gravity="center"
        android:maxLines="1"
        android:shadowColor="@color/colorPrimary"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="8"
        android:textColor="@color/colorWhite"
        android:textSize="120sp"
        android:visibility="visible" />


    <RelativeLayout
        android:id="@+id/recordLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginTop="15dp"
        android:layout_marginEnd="15dp"
        android:layout_marginBottom="32dp"
        android:visibility="visible">

        <ProgressBar
            android:id="@+id/progress_bar"
            style="@style/HorizontalProgressAudio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:progress="0" />


        <RelativeLayout
            android:id="@+id/videoRecordingLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@+id/progress_bar"
            android:visibility="gone"
            android:layout_marginBottom="32dp">


            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/stopRecordIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_gravity="center"
                android:src="@drawable/stop_video_svg" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/tickRecord"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_gravity="center"
                android:layout_marginEnd="50dp"
                android:visibility="visible"
                app:srcCompat="@drawable/tick_svg" />


        </RelativeLayout>



        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/BeforeVideoRecordingLayout"
            android:layout_width="match_parent"
            android:layout_above="@+id/progress_bar"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:paddingHorizontal="60dp">
            <LinearLayout
                android:id="@+id/soundLay"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:background="?android:selectableItemBackground"
                android:gravity="center"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- <com.app.external.RippleView
                     android:id="@+id/rippleLay"
                     android:layout_width="match_parent"
                     android:layout_height="match_parent"
                     ripple:rv_type="rectangle">

                     <LinearLayout
                         android:layout_width="match_parent"
                         android:layout_height="match_parent"
                         android:gravity="center"
                         android:orientation="vertical">-->

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:visibility="visible"
                    app:srcCompat="@drawable/camera_music" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/TextWhiteRegular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="5dp"
                    android:singleLine="true"
                    android:text="@string/sounds"
                    android:textColor="@color/colorWhite"
                    android:textSize="@dimen/text_tiny" />

                <!--</LinearLayout>

            </com.app.external.RippleView>-->

            </LinearLayout>

            <!-- Gallery -->
            <LinearLayout
                android:id="@+id/gallaryLay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?android:selectableItemBackground"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    app:srcCompat="@drawable/galler_icon_svg" />
            </LinearLayout>

            <!-- Record Icon (Center) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toEndOf="@id/gallaryLay"
                app:layout_constraintEnd_toStartOf="@id/flipLay"
                app:layout_constraintHorizontal_bias="0.5">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/recordIcon"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/ripple_effect_oval_white"
                    android:src="@drawable/video_start_svg" />
            </LinearLayout>

            <!-- Flip -->
            <LinearLayout
                android:id="@+id/flipLay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?android:selectableItemBackground"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    app:srcCompat="@drawable/flip_icon_svg" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </RelativeLayout>


    <RelativeLayout
        android:id="@+id/filterRecLay"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_alignParentBottom="true"
        android:background="@color/colorBgBlack"
        android:visibility="gone">

        <TextView
            style="@style/TextWhiteRegular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:layout_toStartOf="@+id/filterClose"
            android:text="@string/portrait"
            android:textSize="@dimen/text_small" />


        <ImageView
            android:id="@+id/filterClose"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/close_white" />


        <!--<com.makeramen.roundedimageview.RoundedImageView
            android:id="@+id/filterClose"
            android:layout_width="18dp"
            android:padding="5dp"
            android:layout_height="18dp"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:adjustViewBounds="true"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSize50Percent"
            app:srcCompat="@drawable/close_white_without_circule"
            app:strokeColor="@color/colorWhite"
            app:strokeWidth="1dp" />

        <com.makeramen.roundedimageview.RoundedImageView
            android:visibility="gone"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:adjustViewBounds="true"
            android:id="@+id/filterClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="25dp"

            android:scaleType="centerCrop"
            android:src="@drawable/close_white_without_circule"
            app:riv_corner_radius="65dp"
            app:riv_border_color="@color/colorWhite"
            app:riv_border_width="2dp"
            app:riv_oval="true"
            app:riv_mutate_background="true" />-->

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/filterRecyclerview"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_below="@+id/filterClose"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:visibility="visible"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_filter" />

    </RelativeLayout>

    <!--<ListView
        android:id="@+id/filterListview"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_alignParentBottom="true"></ListView>-->


    <LinearLayout
        android:id="@+id/cameraOptions"
        android:orientation="vertical"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="15dp"
        android:layout_centerVertical="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/filterLay"
            android:layout_width="75dp"
            android:layout_height="50dp"
            android:layout_below="@+id/flipLay"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.app.helper.LinkEllipseTextView
                style="@style/TextWhiteRegular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:singleLine="true"
                android:text="@string/filter"
                android:fontFamily="@font/outfit_medium"
                android:textColor="@color/colorWhite"
                android:textSize="14sp" />

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:layout_marginStart="6dp"
                android:visibility="visible"
                app:srcCompat="@drawable/filter_svg" />



        </LinearLayout>
        <LinearLayout
            android:id="@+id/flashLay"
            android:layout_width="75dp"
            android:layout_height="50dp"
            android:layout_below="@+id/timerLay"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:gravity="center"
            android:orientation="horizontal">
            <com.app.helper.LinkEllipseTextView
                style="@style/TextWhiteRegular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:singleLine="true"
                android:text="@string/flash"
                android:fontFamily="@font/outfit_medium"
                android:textSize="14sp"
                android:textColor="@color/colorWhite" />
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/flashIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:layout_gravity="center"
                android:visibility="visible"
                app:srcCompat="@drawable/flash_svg" />



        </LinearLayout>
        <LinearLayout
            android:id="@+id/timerLay"
            android:layout_width="75dp"
            android:layout_height="50dp"
            android:layout_below="@+id/filterLay"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:gravity="center"
            android:orientation="horizontal">
            <com.app.helper.LinkEllipseTextView
                style="@style/TextWhiteRegular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/outfit_medium"
                android:singleLine="true"
                android:text="@string/timer"
                android:textColor="@color/colorWhite"
                android:textSize="14sp" />
            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:visibility="visible"
                android:layout_marginStart="6dp"
                app:srcCompat="@drawable/timer_icon_svg" />


        </LinearLayout>





    </LinearLayout>


</RelativeLayout>