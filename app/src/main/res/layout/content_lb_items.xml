<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="5dp"
    android:id="@+id/itemLay"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        android:layout_width="30dp"
        android:layout_height="30dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/mcv"
        android:background="@drawable/rank_bg"
        android:text="0"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        android:textColor="@color/colorPrimary"
        android:textSize="@dimen/text_small"
        android:id="@+id/rankTV"/>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        app:cardBackgroundColor="#FFEFEA"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:id="@+id/mcv"
        app:layout_constraintStart_toEndOf="@id/rankTV"
        app:cardCornerRadius="28dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="3dp">
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    android:layout_centerInParent="true"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:layout_width="46dp"
                        android:scaleType="centerCrop"
                        android:layout_height="46dp"
                        android:src="@drawable/filter_sample_image"
                        android:id="@+id/profilePic"/>

                </com.google.android.material.card.MaterialCardView>

                <ImageView
                    android:layout_width="51dp"
                    android:layout_centerInParent="true"
                    android:id="@+id/isLive"
                    android:visibility="gone"
                    android:layout_height="51dp"
                    android:src="@drawable/live_frame"/>

            </RelativeLayout>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="User Name"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:textSize="@dimen/text_small"
                android:textColor="@color/colorBlack"
                android:layout_gravity="center"
                android:id="@+id/userNameTV"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0k"
                android:layout_marginEnd="20dp"
                android:textSize="@dimen/text_small"
                android:textColor="@color/colorPrimary"
                android:layout_gravity="center|end"
                android:id="@+id/pointsTV"/>

        </LinearLayout>


    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>