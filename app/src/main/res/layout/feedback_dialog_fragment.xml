<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.appcompat.widget.Toolbar
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:id="@+id/toolbar">

        <ImageButton
            android:layout_width="?attr/actionBarSize"
            android:layout_height="?attr/actionBarSize"
            android:background="?selectableItemBackgroundBorderless"
            android:src="@drawable/mls_img_cross"
            android:scaleType="centerInside"
            android:padding="10dp"
            android:id="@+id/closeBtn"
            app:tint="@color/colorBlackLt" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Feedback"
            android:textSize="@dimen/text_large_medium"
            android:textStyle="bold"
            android:layout_gravity="center"
            />


    </androidx.appcompat.widget.Toolbar>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/progress_indicator_lay"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:indeterminate="true"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="20dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/progress_indicator_lay">

        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine"
            android:background="@drawable/curved_accent"
            android:backgroundTint="#315C5585"
            android:minHeight="100dp"
            android:hint="Type your live stream related feedback here!"
            android:padding="15dp"
            android:maxLength="500"
            android:layout_marginTop="10dp"
            android:maxLines="6"
            android:textColor="@color/colorBlack"
            android:gravity="start|top"
            android:id="@+id/description"/>

        <CheckBox
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Upload exception log"
            android:textColor="@color/colorBlack"
            android:layout_marginTop="10dp"
            android:textSize="@dimen/text_medium_large"
            android:paddingStart="5dp"
            android:id="@+id/uploadLogCB"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="The log only contains fault records and necessary system informations in the recent period, and does not contain any private information such as chat records."
/>
        

    </LinearLayout>

    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/colorPrimary"
        android:background="@drawable/curved_accent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="20dp"
        android:text="submit"
        android:paddingStart="30dp"
        android:paddingEnd="30dp"
        android:textSize="@dimen/text_medium_large"
        android:textColor="@color/colorWhite"
        android:textStyle="bold"
        android:id="@+id/submit"/>

    
</androidx.constraintlayout.widget.ConstraintLayout>