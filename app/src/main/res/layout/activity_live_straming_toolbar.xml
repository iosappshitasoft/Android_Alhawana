<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.Toolbar xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/toolbar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/colorBlack"
    android:minHeight="?attr/actionBarSize"
    app:contentInsetStart="0dp">

    <RelativeLayout
        android:layoutDirection="locale"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/toolbar_start_margin"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/arrow_w_l"
            android:visibility="visible" />

        <ImageView
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:layout_marginStart="25dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/notification_batch"
            android:gravity="center"
            android:padding="10dp"
            android:textColor="@android:color/white"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/btnSettings"
            android:layout_toEndOf="@+id/btnBack"
            android:gravity="start"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtTitle"
                style="@style/TextWhiteRegular"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:textDirection="locale"
                android:gravity="start"
                android:textSize="@dimen/toolbar_title" />


        </LinearLayout>

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/btnSettings"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:adjustViewBounds="true"
            android:scaleType="centerCrop"
            android:layout_marginEnd="15dp"
            android:src="@drawable/settings_white"
            android:layout_alignParentEnd="true"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSize50Percent"
            android:visibility="gone" />

        <TextView
            android:id="@+id/text_test"
            android:layout_width="70dp"
            android:gravity="end"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginBottom="2dp"
            android:layout_marginEnd="5dp"
            android:visibility="invisible"
            android:text="@string/my_videos"
            android:layout_below="@+id/btnSettings"
            android:textColor="@color/white"
            android:textSize="@dimen/text_small"/>

    </RelativeLayout>

</androidx.appcompat.widget.Toolbar>
