<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/grey_background"
    android:padding="16dp">

    <ImageButton
        android:id="@+id/btnDeleteAudio"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@android:color/transparent"
        android:src="@android:drawable/ic_menu_delete"
        app:tint="@color/colorWhite"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/btnDone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/done"
        android:textColor="@color/colorWhite"
        android:textStyle="bold"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ProgressBar
        android:id="@+id/progressTrim"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@+id/btnDone"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginEnd="8dp"/>

    <ImageView
        android:id="@+id/imgArt"
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_thumb_rounded"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnDeleteAudio" />

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="@string/audio_name"
        android:textColor="@color/colorWhite"
        android:textStyle="bold"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="@+id/imgArt"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/imgArt"
        app:layout_constraintTop_toTopOf="@+id/imgArt" />

    <LinearLayout
        android:id="@+id/volumeRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imgArt">

        <TextView
            android:id="@+id/volumeValue"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            tools:text="5"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:background="@drawable/bg_volume_bubble" />

        <SeekBar
            android:id="@+id/volumeSeek"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/trimTimeDisplay"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/volumeRow">

        <TextView
            android:id="@+id/txtStartTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="0:00"
            android:textColor="@color/colorWhite"
            android:textSize="12sp"
            android:fontFamily="monospace" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" - "
            android:textColor="@color/colorWhite"
            android:textSize="12sp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/txtEndTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="0:00"
            android:textColor="@color/colorWhite"
            android:textSize="12sp"
            android:fontFamily="monospace" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" ("
            android:textColor="@color/colorWhite"
            android:textSize="12sp"
            android:layout_marginStart="8dp" />

        <TextView
            android:id="@+id/txtDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="0:00"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=")"
            android:textColor="@color/colorWhite"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/trimRow"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/trimTimeDisplay">

        <FrameLayout
            android:id="@+id/trimContainer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="8dp"
            android:background="@drawable/bg_trim_box">

            <com.google.android.material.slider.RangeSlider
                android:id="@+id/trimSlider"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                app:thumbRadius="0dp"
                app:thumbColor="@android:color/transparent"
                app:haloRadius="0dp"
                app:tickVisible="false"
                app:haloColor="@android:color/transparent"
                app:thumbTint="@android:color/transparent"
                app:trackHeight="4dp"
                app:trackColorActive="@color/colorAccent"
                app:trackColorInactive="@color/colorAccent"
                app:labelBehavior="withinBounds" />

            <com.app.camera.audioimage.SimpleWaveformView
                android:id="@+id/waveformView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/handleLeft"
                android:layout_width="32dp"
                android:layout_height="match_parent"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/bg_handle_left"
                android:clickable="false"
                android:focusable="false"
                android:padding="6dp"
                android:src="@drawable/ic_chevron_left_white"
                app:tint="@color/colorWhite" />

            <ImageView
                android:id="@+id/handleRight"
                android:layout_width="32dp"
                android:layout_height="match_parent"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/bg_handle_right"
                android:clickable="false"
                android:focusable="false"
                android:padding="6dp"
                android:src="@drawable/ic_chevron_right_white"
                app:tint="@color/colorWhite" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/btnPlay"
            android:layout_marginTop="8dp"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_next_button"
            android:src="@android:drawable/ic_media_play"
            app:tint="@color/colorWhite" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

