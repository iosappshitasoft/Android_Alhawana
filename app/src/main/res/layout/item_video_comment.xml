<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp">

    <com.makeramen.roundedimageview.RoundedImageView

        android:id="@+id/profileImage"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="center"
        android:adjustViewBounds="true"
        android:padding="2dp"
        android:scaleType="centerCrop"
        android:src="@drawable/loginscreen_bg"
        app:riv_corner_radius="65dp"
        app:riv_mutate_background="true"
        android:visibility="gone"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:id="@+id/linearlayout">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/profileImageNew"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:scaleType="centerCrop"
            android:src="@drawable/loginscreen_bg"
            app:shapeAppearanceOverlay="@style/RoundedImage" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/userName"
            android:textFontWeight="600"
            android:layout_gravity="center"
            style="@style/OutfitRegularForHeadingLiteWhiteSize14"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="13dp"
            android:layout_marginEnd="5dp"
            android:textDirection="locale"
            android:layout_toStartOf="@+id/deleteIcon"
            android:layout_toEndOf="@+id/profileImage"
            android:text="Mknow"
            android:fontFamily="@font/outfit_medium"
            android:textSize="@dimen/text_medium"
            />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/messageDateandTime"
            android:textFontWeight="400"
            android:layout_gravity="center"
            style="@style/OutfitRegularForHeadingLiteWhiteSize8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:textDirection="locale"
            android:layout_toStartOf="@+id/deleteIcon"
            android:layout_toEndOf="@+id/profileImage"
            android:text=""
            android:textSize="10sp"
            android:layout_weight="1"/>

        <ImageView
            android:id="@+id/deleteIcon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_alignParentEnd="true"
            android:layout_centerInParent="true"
            android:padding="8dp"
            android:src="@drawable/comment_delete" />


    </LinearLayout>

    <com.app.view.CustomSpannableTextView
        android:id="@+id/userComment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/linearlayout"
        android:layout_marginTop="2dp"
        android:padding="5dp"
        android:layout_marginEnd="5dp"
        android:lineSpacingExtra="2dp"
        android:textDirection="locale"
        android:maxEms="10"
        android:minEms="2"
        android:textFontWeight="400"
        android:textColor="#A8A8A8"
        android:textColorLink="@color/colorBlack"
        android:fontFamily="@font/outfit_medium"
        android:text="@string/camera2_texture_only_error"
        android:textSize="@dimen/text_normal" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="2dp"
        android:layout_below="@+id/userComment"
        android:background="@color/bottomsheet_viewline"/>


</RelativeLayout>

