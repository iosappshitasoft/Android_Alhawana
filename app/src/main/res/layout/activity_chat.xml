            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/chatInputRoot"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginBottom="10dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layoutDirection="locale">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/constraint_check"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_chat_input"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/btnSend"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <ImageView
                        android:id="@+id/btnGif"
                        android:layout_width="30dp"
                        android:layout_height="wrap_content"
                        android:padding="5dp"
                        android:visibility="gone"
                        android:src="@drawable/gif"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        app:tint="@color/colorWhite"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />
                    <EditText
                        android:id="@+id/edtMessage"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:hint="@string/type_your_message"
                        android:inputType="textCapSentences|textMultiLine"
                        android:lines="3"
                        android:textSize="14sp"
                        android:textColorHint="@color/secondarytext"
                        android:textColor="@color/grayclr"
                        android:gravity="start|top"
                        android:scrollbars="vertical"
                        android:padding="15dp"
                        android:layout_marginStart="0dp"

                        android:textDirection="firstStrong"
                        android:layoutDirection="locale"

                        app:layout_constraintStart_toEndOf="@id/btnGif"
                        app:layout_constraintEnd_toStartOf="@id/btnAdd"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />



                    <ImageView
                        android:id="@+id/btnAdd"
                        android:layout_width="30dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="5dp"
                        android:layout_marginEnd="15dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="5dp"
                        android:src="@drawable/chat_attachment"
                        app:tint="@color/colorWhite"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <ImageView
                    android:id="@+id/btnSend"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:padding="10dp"
                    android:scaleType="center"
                    android:src="@drawable/send_svg_chat"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>






