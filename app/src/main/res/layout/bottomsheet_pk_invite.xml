<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_match_invite"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:id="@+id/title"
        android:textSize="@dimen/text_medium_large"
        android:textColor="@color/colorBlack"
        android:textStyle="bold"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="parent"
        android:id="@+id/cl"
        app:layout_constraintEnd_toEndOf="parent"
        android:padding="20dp"
        android:background="@drawable/bg"
        app:layout_constraintTop_toBottomOf="@id/title">

      <!--  <ImageView
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:src="@drawable/bg"
            android:scaleType="centerCrop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
-->

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:id="@+id/lay1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/iv">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardCornerRadius="40dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/white">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/filter_sample_image"
                    android:scaleType="centerCrop"
                    android:id="@+id/host1Img"/>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_gravity="center"
                android:layout_marginTop="10dp"
                android:id="@+id/host1Name"
                android:layout_width="wrap_content"
                android:textColor="@color/colorBlack"
                android:layout_height="wrap_content"
                tools:text="hellooo"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/lay2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv"
            app:layout_constraintEnd_toEndOf="parent">


            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardCornerRadius="40dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/white">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/filter_sample_image"
                    android:scaleType="centerCrop"
                    android:id="@+id/host2Img"/>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_gravity="center"
                android:layout_marginTop="10dp"
                android:id="@+id/host2Name"
                android:textColor="@color/colorBlack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="hellooo"/>


        </LinearLayout>

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/iv"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/lay2"
            app:layout_constraintStart_toEndOf="@+id/lay1">

            <ImageView
                android:layout_width="100dp"
                android:scaleType="centerCrop"
                android:layout_height="100dp"
                android:src="@drawable/battle_iv" />

        <!--    <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/battle"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="10dp"/>-->

        </RelativeLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.button.MaterialButton
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cornerRadius="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cl"
        android:text="@string/action_start_match"
        android:visibility="gone"
        android:textStyle="bold"
        android:id="@+id/startMatch"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cl"
        android:id="@+id/acceptLay">

        <com.google.android.material.button.MaterialButton
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cornerRadius="20dp"
            android:layout_weight="1"
            app:strokeColor="@color/background_progress_color"
            app:strokeWidth="2dp"
            app:elevation="0dp"
            app:backgroundTint="@color/white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cl"
            android:text="@string/action_decline"
            android:textColor="@color/background_progress_color"
            android:textStyle="bold"
            android:layout_marginEnd="4dp"
            android:id="@+id/decline"/>

        <com.google.android.material.button.MaterialButton
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cornerRadius="20dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cl"
            android:text="@string/action_accept"
            android:textStyle="bold"
            android:id="@+id/accept"/>

    </LinearLayout>



</androidx.constraintlayout.widget.ConstraintLayout>