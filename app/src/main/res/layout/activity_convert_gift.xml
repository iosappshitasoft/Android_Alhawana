<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/parentLay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBlack">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:id="@+id/toolbar"
        android:layout_marginTop="32dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/toolbar_start_margin"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/back"
            android:visibility="visible" />


        <TextView
            android:id="@+id/txtTitle"
            android:textFontWeight="600"
            style="@style/OutfitRegularForHeadingWhiteSize18"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="My Gifts" />


    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/toolbar"
        android:layout_above="@+id/btnWithdraw"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="10dp"
        android:orientation="vertical">

        <ImageView
            android:layout_width="156dp"
            android:layout_height="120dp"
            android:src="@drawable/giftboximage"
            android:layout_gravity="center"
            android:layout_margin="24dp"/>

        <TextView
            android:visibility="gone"
            android:id="@+id/txtAvailableGems"
            android:textFontWeight="600"
            style="@style/OutfitRegularForHeadingLiteWhiteSize16"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Invite Your Friends Reward \n Yourself"
            android:layout_gravity="center"
            android:gravity="center"/>

        <TextView
            android:textFontWeight="600"
            style="@style/OutfitRegularForHeadingLiteWhiteSize16"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/invite_yourfriendreqardyourslef"
            android:layout_gravity="center"
            android:gravity="center"
            android:layout_margin="2dp"/>

        <TextView
            android:id="@+id/txt_description"
            android:fontFamily="@font/outfit_regular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="12dp"
            android:text="@string/free_gems_content"
            android:textSize="@dimen/text_small"
            android:maxLines="2"
            android:textFontWeight="400"
            android:textColor="#A8A8A8"
            android:layout_gravity="center"/>

        <LinearLayout
            android:id="@+id/topLay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:background="@drawable/bottom_sheet_20">

            <TextView
                android:id="@+id/countDisplay"
                style="@style/TextWhiteRegular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:gravity="center"
                android:textColor="@color/colorWhite"
                android:textSize="@dimen/text_normal"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/txtGiftsCount"
                style="@style/TextWhiteRegular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/colorWhite"
                android:textSize="@dimen/text_normal"
                android:visibility="gone"/>

