            <!-- First Option -->
            <LinearLayout
                android:id="@+id/optionCoins"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <RadioButton
                    android:id="@+id/btnGems"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:button="@drawable/custom_radio_button"
                    android:focusable="false"
                    android:focusableInTouchMode="false" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtPackageName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/coins"
                        android:textFontWeight="600"
                        android:textSize="16dp"
                        android:ellipsize="end"
                        android:layout_marginStart="12dp"
                        android:singleLine="true"
                        style="@style/OutfitRegularForHeadingLiteWhiteSize16" />

                    <TextView
                        android:id="@+id/txtPriceDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/grey_decor"
                        android:fontFamily="@font/outfit_regular"
                        android:textSize="14dp"
                        android:textAlignment="viewEnd"
                        android:textFontWeight="500" />
                </LinearLayout>
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/viewline"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="18dp"/>

            <!-- Second Option -->
            <LinearLayout
                android:id="@+id/optionCash"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <RadioButton
                    android:id="@+id/btnCash"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:button="@drawable/custom_radio_button"
                    android:focusable="false"
                    android:focusableInTouchMode="false" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtCashValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/money"
                        android:textFontWeight="600"
                        android:textSize="16dp"
                        android:layout_marginStart="12dp"
                        android:ellipsize="end"
                        android:singleLine="true"
                        style="@style/OutfitRegularForHeadingLiteWhiteSize16" />

                    <TextView
                        android:id="@+id/txtCashDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/grey_decor"
                        android:fontFamily="@font/outfit_regular"
                        android:textSize="14dp"
                        android:textAlignment="viewEnd"
                        android:textFontWeight="500" />
                </LinearLayout>
            </LinearLayout>


        </LinearLayout>


    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        style="@style/CircularProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginStart="5dp"
        android:layout_marginBottom="0dp"
        android:visibility="gone"/>

    <include
        android:id="@+id/nullLay1"
        layout="@layout/null_lay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:visibility="gone"/>

    <include layout="@layout/layout_adview" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnWithdraw"
        style="@style/TextWhiteRegular"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/colorGift"
        android:insetTop="4dp"
        android:insetBottom="4dp"
        android:letterSpacing="0"
        android:lineSpacingExtra="1dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="28dp"
         android:text="@string/convert_gems"
        android:textAllCaps="false"
        android:textSize="@dimen/text_normal"
        android:visibility="visible"
        app:cornerRadius="8dp"
        android:background="@drawable/bg_12"
        app:backgroundTint="@color/colorPrimary"
        tools:ignore="MissingConstraints"
        android:layout_alignParentBottom="true"/>

</RelativeLayout><!--
