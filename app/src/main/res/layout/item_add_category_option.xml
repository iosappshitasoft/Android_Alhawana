<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/ll_category_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="3dp">

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginEnd="-12dp"
            android:layout_marginStart="-12dp">

            <View
                android:id="@+id/v_glow"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_neon_glow" />

            <FrameLayout
                android:id="@+id/fl_icon_container"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_category_icon_purple">
                
                <ImageView
                    android:id="@+id/iv_category_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    tools:src="@drawable/ic_cat_entertainment" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/tv_category_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            tools:text="Entertainment &amp; Fun" />

        <ImageView
            android:id="@+id/iv_chevron"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/arrow_right"
            android:visibility="gone"
            app:tint="#FFFFFF"
            tools:visibility="visible" />
    </LinearLayout>

    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="70dp"
        android:background="#1AFFFFFF" />

</LinearLayout>
