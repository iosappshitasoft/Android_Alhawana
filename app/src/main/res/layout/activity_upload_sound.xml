                        android:textSize="@dimen/text_medium_large" />

                    <ImageView
                        android:id="@+id/btnClear"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:padding="12dp"
                        android:src="@drawable/cancel"
                        android:visibility="gone" />

                </RelativeLayout>

            </androidx.appcompat.widget.Toolbar>-->

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/colorPrimaryDark"
                app:popupTheme="@style/ThemeOverlay.AppCompat.Light">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/btnBack"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:padding="10dp"
                        android:src="@drawable/back" />

                    <TextView
                        android:id="@+id/toolbarTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:text="@string/sounds"
                        android:fontFamily="@font/outfit_regular"
                        android:textColor="@color/colorWhite"
                        android:textSize="16sp"
                        />

                </RelativeLayout>

            </androidx.appcompat.widget.Toolbar>


            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="19dp"
                android:layout_marginEnd="19dp"
                android:padding="8dp"

                android:background="@drawable/bg_card_curve"                >
                <ImageView
                    android:id="@+id/btnClear"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="10dp"
                    android:padding="4dp"
                    android:src="@drawable/close_icon"
                    android:visibility="gone"
                    android:background="?attr/selectableItemBackgroundBorderless" />


                <EditText
                    android:id="@+id/edtSearch"
                    style="@style/TextWhiteLight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/search_sounds"
                    android:padding="10dp"
                    android:background="@android:color/transparent"
                    android:layout_marginTop="5dp"
                    android:textColorHint="#8F8F8F"
                    android:fontFamily="@font/outfit_medium"
                    android:singleLine="true"
                    android:layout_toRightOf="@+id/searchIcon"
                    android:textAlignment="viewStart"
                    android:textSize="@dimen/text_normal" />

                <ImageView
                    android:id="@+id/searchIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="5dp"
                    android:src="@drawable/search" />

            </RelativeLayout>




            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical">
                <LinearLayout
                    android:id="@+id/tabLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@color/colorBlack"
                    android:weightSum="2">

                    <LinearLayout
                        android:id="@+id/layoutDiscover"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">

                        <TextView
                            android:id="@+id/btnDiscover"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingVertical="12dp"
                            android:fontFamily="@font/outfit_regular"
                            android:text="@string/discover"
                            android:textAllCaps="false"
                            android:textColor="@color/colorSecondaryText"
                            android:textSize="18sp" />

                        <View
                            android:id="@+id/indicatorDiscover"
                            android:layout_width="match_parent"
                            android:layout_height="2dp"
                            android:background="@color/colorPrimary1"
                            android:visibility="visible" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutFav"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">

                        <TextView
                            android:id="@+id/btnFav"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingVertical="12dp"
                            android:fontFamily="@font/outfit_regular"
                            android:text="@string/favourites"
                            android:textAllCaps="false"
                            android:textColor="@color/colorSecondaryText"
                            android:textSize="18sp" />

                        <View
                            android:id="@+id/indicatorFav"
                            android:layout_width="match_parent"
                            android:layout_height="2dp"
                            android:background="@color/colorPrimary1"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:id="@+id/tabStrokeLine"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginTop="-2dp"
                    android:background="@color/bottomsheet_viewline" />

            </LinearLayout>

        </com.google.android.material.appbar.AppBarLayout>

        <RelativeLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">

            <androidx.viewpager.widget.ViewPager
                android:id="@+id/fragment_home_viewpager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_above="@id/spacer"/>

            <androidx.legacy.widget.Space
                android:id="@+id/spacer"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_alignParentBottom="true" />

        </RelativeLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

</FrameLayout>