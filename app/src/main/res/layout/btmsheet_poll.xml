<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@drawable/bottom_sheet_bg_32dp"
    android:paddingTop="16dp"
    android:paddingBottom="48dp">

    <View
        android:id="@+id/divider1"
        android:layout_width="38dp"
        android:layout_height="4dp"
        android:background="@drawable/curved_accent"
        android:alpha="0.3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_poll"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:layout_marginTop="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divider1" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/title"
        app:layout_constraintBottom_toBottomOf="@id/title">

        <ImageView
            android:id="@+id/btnAddOption"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_poll_add"
            android:padding="2dp"
            app:tint="@color/white"
            android:background="?selectableItemBackgroundBorderless" />

        <ImageView
            android:id="@+id/btnHelp"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="16dp"
            android:src="@drawable/ic_poll_help"
            android:padding="2dp"
            app:tint="@color/white"
            android:background="?selectableItemBackgroundBorderless" />
    </LinearLayout>

    <!-- Question Container -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvQuestion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="32dp"
        app:cardCornerRadius="20dp"
        app:cardBackgroundColor="#0D000000"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="#0DFFFFFF"
        app:layout_constraintTop_toBottomOf="@id/title">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="20dp"
            android:gravity="top">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/poll_question_sample"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:lineSpacingExtra="4dp" />

            <ImageView
                android:id="@+id/btnEditQuestion"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="12dp"
                android:src="@drawable/ic_poll_edit"
                app:tint="#888888" />

            <ImageView
                android:id="@+id/btnClearQuestion"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="12dp"
                android:padding="3dp"
                android:src="@drawable/ic_poll_cancel"
                app:tint="#888888" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Option A -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvOptionA"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="16dp"
        app:cardBackgroundColor="#05FFFFFF"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="#0DFFFFFF"
        app:layout_constraintTop_toBottomOf="@id/cvQuestion">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="20dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/poll_option_a"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Option B -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvOptionB"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="16dp"
        app:cardBackgroundColor="#05FFFFFF"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="#0DFFFFFF"
        app:layout_constraintTop_toBottomOf="@id/cvOptionA">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="20dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/poll_option_b"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Bottom Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="32dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/cvOptionB">

        <!-- Time Selector -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardCornerRadius="99dp"
            app:cardBackgroundColor="#1AFFFFFF"
            app:strokeWidth="1dp"
            app:strokeColor="#0DFFFFFF"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/timer"
                    app:tint="#888888" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    tools:text="5m"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/downarrow"
                    app:tint="#888888" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Start Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnStart"
            android:layout_width="wrap_content"
            android:layout_height="47dp"
            android:minWidth="120dp"
            android:text="@string/action_start"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/bg_start_btn"
            android:textAllCaps="false"
            android:elevation="12dp"
            android:outlineAmbientShadowColor="#66A855F7"
            android:outlineSpotShadowColor="#66A855F7"
            tools:targetApi="p"
            android:paddingHorizontal="32dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
