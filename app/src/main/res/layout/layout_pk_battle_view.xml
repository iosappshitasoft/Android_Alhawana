<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E1E24">

    <!-- Background Profile Image when camera is off -->
    <ImageView
        android:id="@+id/pk_bg_profile_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/alhawana"
        android:visibility="gone" />

    <!-- Dark overlay over the background image -->
    <View
        android:id="@+id/pk_bg_profile_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone" />

    <!-- Video Container for ZEGOVideoView -->
    <FrameLayout
        android:id="@+id/pk_video_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Center Avatar Circle when camera is off -->
    <com.app.Zego.components.LetterIconView
        android:id="@+id/pk_center_avatar"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- Sound/Speaker Icon (top-right for Co-host) -->
    <ImageView
        android:id="@+id/pk_sound_icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:padding="8dp"
        android:background="@drawable/bg_blur_radius_16"
        android:backgroundTint="#CC1C3549"
        android:src="@drawable/unmute"
        app:tint="@color/white"
        android:visibility="gone" />

    <!-- Mic Status Icon (bottom-right for Host) -->
    <ImageView
        android:id="@+id/pk_mic_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="12dp"
        android:layout_marginEnd="12dp"
        android:padding="10dp"
        android:background="@drawable/bg_blur_radius_16"
        android:backgroundTint="#CC1C3549"
        android:src="@drawable/ic_mic"
        app:tint="@color/white"
        android:visibility="gone" />

    <!-- User Name Capsule (bottom-right) -->
    <TextView
        android:id="@+id/pk_user_name_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="12dp"
        android:layout_marginEnd="12dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:background="@drawable/bg_blur_radius_16"
        android:backgroundTint="#CC1C3549"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:visibility="gone" />

</FrameLayout>
