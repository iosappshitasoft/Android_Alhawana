<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@drawable/bottom_sheet_white_bg"
    android:paddingVertical="24dp"
    android:paddingHorizontal="16dp"
    android:backgroundTint="@color/surface_color">
    <View
        android:layout_width="38dp"
        android:layout_height="4dp"
        android:background="@drawable/curved_accent"
        android:alpha="0.3"
        android:id="@+id/divider1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_gravity="center"/>


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/invite_to_join_live"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divider1"
        app:layout_constraintEnd_toEndOf="parent"
        android:paddingVertical="24dp"
        android:textColor="@color/white"
        android:id="@+id/title"
        style="@style/TextBlackRegular"
        android:layout_gravity="center"/>

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="2dp"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:dividerThickness="2dp"
        app:dividerColor="#35383F"
        android:id="@+id/divider2"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:id="@+id/userLay"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/divider2"
        android:layout_marginTop="24dp">

        <com.makeramen.roundedimageview.RoundedImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_launcher"
            app:riv_oval="true"
            app:riv_mutate_background="true"
            android:scaleType="centerCrop"
            app:riv_border_width="0dp"
            android:id="@+id/userImage"/>


        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1"
            android:layout_marginHorizontal="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                tools:text="User Name"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:id="@+id/userName"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_marginTop="8dp"
                tools:text="User Bio"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:id="@+id/userBio"/>


        </LinearLayout>

        <TextView
            android:paddingHorizontal="16dp"
            android:backgroundTint="#9935383F"
            android:paddingVertical="6dp"
            android:background="@drawable/curved_accent"
            android:id="@+id/viewerscount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:textSize="12sp"
            android:drawablePadding="8dp"
            android:textStyle="bold"
            android:drawableStart="@drawable/new_viewers_count"
            tools:text="0"
            android:textColor="@color/white" />

    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2"
        android:id="@+id/btnLay"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/userLay">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/decline"
            android:textSize="16sp"
            android:letterSpacing="0.01"
            android:textColor="@color/colorPrimary"
            android:paddingVertical="12dp"
            android:gravity="center"
            android:textAllCaps="true"
            android:layout_marginEnd="6dp"
            android:textStyle="bold"
            android:id="@+id/btnDecline"
            android:background="@drawable/pk_request_btn_bg"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/accept"
            android:textSize="16sp"
            android:letterSpacing="0.01"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:paddingVertical="12dp"
            android:gravity="center"
            android:id="@+id/btnAccept"
            android:textAllCaps="true"
            android:backgroundTint="@color/colorPrimary"
            android:background="@drawable/pk_request_btn_bg"/>

    </LinearLayout>


    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="2dp"
        app:layout_constraintTop_toBottomOf="@id/btnLay"
        app:dividerThickness="2dp"
        app:dividerColor="#35383F"
        android:visibility="invisible"
        android:layout_marginVertical="24dp"/>



</androidx.constraintlayout.widget.ConstraintLayout>