<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/StyleRoot"
    android:background="#050505"
    tools:context=".ActVideoTrimmer">


    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardCornerRadius="32dp"
        app:cardElevation="0dp"
        android:layout_marginTop="32dp"
        android:background="#050505"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:id="@+id/cardVideo"
        app:layout_constraintTop_toBottomOf="@+id/topBar"
        app:layout_constraintBottom_toTopOf="@+id/controlsLay"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

<!--        <com.google.android.exoplayer2.ui.StyledPlayerView-->
<!--            android:id="@+id/player_view_lib"-->
<!--            android:layout_width="match_parent"-->
<!--            android:layout_height="match_parent"-->
<!--            android:background="@color/colorBlack"-->
<!--            android:clipToOutline="true"-->
<!--            app:resize_mode="fill"-->
<!--            app:use_controller="false" />-->

        <!-- ✅ FrameLayout helps stack player and progress bar -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.google.android.exoplayer2.ui.StyledPlayerView
                android:id="@+id/player_view_lib"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/colorBlack"
                android:clipToOutline="true"
                app:resize_mode="fill"
                app:use_controller="false" />
            <ImageView
                android:id="@+id/image_play_pause"
                style="@style/WView"
                android:layout_width="48dp"
                android:background="@drawable/shape_circle_lib"
                android:src="@drawable/ic_video_play_lib"
                android:layout_height="48dp"
                android:layout_gravity="center" />

            <!-- 🟦 CROP SQUARE OVER VIDEO -->
            <View
                android:id="@+id/cropOverlay"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_gravity="center"
                android:background="@drawable/crop_border"
                android:visibility="gone"/>
        </FrameLayout>
    </androidx.cardview.widget.CardView>


<!--    <ImageView-->
<!--        android:id="@+id/image_play_pause"-->
<!--        style="@style/WView"-->
<!--        android:layout_centerInParent="true"-->
<!--        android:background="@drawable/shape_circle_lib"-->
<!--        android:padding="12dp"-->
<!--        android:src="@drawable/ic_video_play_lib"-->
<!--        android:visibility="gone"-->
<!--        app:layout_constraintBottom_toBottomOf="parent"-->
<!--        app:layout_constraintEnd_toEndOf="parent"-->
<!--        app:layout_constraintStart_toStartOf="parent"-->
<!--        app:layout_constraintTop_toTopOf="parent" />-->

    <ProgressBar
        android:id="@+id/progress_circular"
        style="@style/WView"
        android:layout_centerInParent="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <!-- Sticker options -->
    <LinearLayout
        android:id="@+id/stickerControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
       app:layout_constraintTop_toBottomOf="@+id/controlsLay"
        android:paddingTop="8dp">

        <EditText
            android:id="@+id/etStickerText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Add sticker text (optional)"
            android:singleLine="true"
            android:imeOptions="actionDone"
            android:background="@drawable/bg_primary_curved"
            android:padding="10dp"
            android:textColor="@color/colorWhite"
            android:textColorHint="#80FFFFFF"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnToggleStickerMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sticker Mode" />

            <Space android:layout_width="12dp" android:layout_height="wrap_content"/>

            <Button
                android:id="@+id/btnCropReset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reset Crop"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/controlsLay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="25dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent">

        <include
            layout="@layout/view_video_controller"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom" />

        <Button
            android:id="@+id/btnNext"
            style="@style/ButtonPrimaryBold1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="0dp"
            android:fontFamily="@font/outfit_regular"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/next"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:textSize="16sp"
            android:textAllCaps="false"
            android:textColor="@color/colorWhite"
            android:backgroundTint="@color/colorPrimary"
            />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="30dp"
        android:id="@+id/topBar"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:layout_gravity="start"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:src="@drawable/camera_close_svg"
            android:visibility="visible" />

        <LinearLayout
            android:id="@+id/soundLay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:gravity="center"
            android:background="@drawable/camera_music_bg"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:id="@+id/ivMusic"
                android:visibility="visible"
                app:srcCompat="@drawable/camera_music_svg" />

            <com.app.helper.LinkEllipseTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"

                android:singleLine="true"
                android:text="@string/sounds"
                android:fontFamily="@font/outfit_medium"
                android:layout_marginStart="8dp"
                android:id="@+id/txtSound"
                android:textColor="@color/colorWhite"
                android:textSize="14sp" />

        </LinearLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>