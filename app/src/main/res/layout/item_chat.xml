<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/itemLay"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_curve"
    android:clickable="true"
    android:layout_marginBottom="10dp"
    android:padding="5dp"
    android:focusable="true"
    android:orientation="vertical"
    android:layoutDirection="locale">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp">

        <com.makeramen.roundedimageview.RoundedImageView
            android:id="@+id/profileImage"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="5dp"
            android:adjustViewBounds="true"
            android:scaleType="centerCrop"
            android:src="@drawable/loginscreen_bg"
            app:riv_corner_radius="65dp"
            app:riv_mutate_background="true" />

        <ImageView
            android:id="@+id/iconOnline"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_alignEnd="@id/profileImage"
            android:layout_alignBottom="@id/profileImage"
            android:translationX="2dp"
            android:src="@drawable/online"
            android:visibility="invisible" />

        <RelativeLayout
            android:id="@+id/contentLay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="5dp"
            android:layout_toEndOf="@+id/iconOnline">

            <TextView
                android:id="@+id/txtName"
                style="@style/TextBlackRegular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:maxLines="1"
                android:textColor="@color/colorWhite"
                android:textAlignment="viewStart"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/msgLay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/txtName"
                android:layout_marginTop="5dp"
                android:layout_alignStart="@+id/txtName"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iconPhoto"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_gravity="center_vertical"
                    android:padding="5dp"
                    android:src="@drawable/gallery"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/txtMessage"
                    style="@style/TextPrimaryLight"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/colorWhite"
                    android:textAlignment="viewStart"
                    android:textSize="@dimen/text_normal" />

                <TextView
                    android:id="@+id/txtChatTime"
                    style="@style/TextSecondaryLight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:maxLines="1"
                    android:textAlignment="viewEnd"
                    android:textColor="@color/colorWhite"
                    android:textSize="@dimen/text_small" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtTyping"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/txtName"
                android:layout_alignStart="@id/txtName"
                android:layout_alignBottom="@id/msgLay"
                android:gravity="start"
                android:maxLines="1"
                android:text="@string/typing"
                android:textColor="@color/colorPrimary"
                android:textSize="13sp"
                android:visibility="invisible"
                style="@style/TextSecondaryLight" />



        </RelativeLayout>
    </RelativeLayout>
</LinearLayout>
