<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/parentLay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:keepScreenOn="true"
    android:fitsSystemWindows="false">

    <!-- Content area: ViewPager takes remaining space -->
    <com.app.alhawanajd.home.CustomViewPager
        android:id="@+id/fragment_home_viewpager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never" />

    <FrameLayout
        android:id="@+id/constraintLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/app_decorview_color">

        <!-- Standard BottomNavigationView (visible by default) -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@color/app_decorview_color"
            android:visibility="visible"
            app:itemHorizontalTranslationEnabled="true"
            app:itemIconSize="50dp"
            android:layoutDirection="@string/layout_direction"
            app:itemIconTint="@color/nav_color"
            app:itemPaddingBottom="0dp"
            app:itemPaddingTop="0dp"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/fundoo_home_menu" />

        <!-- Custom bottom navigation (hidden by default) -->
        <LinearLayout
            android:id="@+id/bottom_navigation_custom"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginEnd="13dp"
            android:layout_gravity="center_vertical|start"
            android:background="@drawable/bottom_navigation_background"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <!-- Home -->
            <ImageView
                android:id="@+id/btnHome"
                android:layout_width="0dp"
                android:layout_height="62dp"
                android:layout_margin="1dp"
                android:layout_weight="1"
                android:background="@drawable/bg_top_selection_2"
                android:paddingStart="22dp"
                android:paddingTop="20dp"
                android:paddingEnd="22dp"
                android:paddingBottom="20dp"
                android:src="@drawable/img_1_home_selected" />

            <View
                android:layout_width="15dp"
                android:layout_height="match_parent"
                android:background="@android:color/transparent" />

            <!-- Search -->
            <ImageView
                android:id="@+id/btnSearch"
                android:layout_width="0dp"
                android:layout_height="62dp"
                android:layout_margin="1dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:paddingStart="22dp"
                android:paddingTop="20dp"
                android:paddingEnd="22dp"
                android:paddingBottom="20dp"
                android:src="@drawable/img_1_search_unselected" />

            <View
                android:layout_width="15dp"
                android:layout_height="match_parent"
                android:background="@android:color/transparent" />

            <!-- Chat -->
            <ImageView
                android:id="@+id/btnChat"
                android:layout_width="0dp"
                android:layout_height="62dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:paddingStart="22dp"
                android:paddingTop="20dp"
                android:paddingEnd="22dp"
                android:paddingBottom="20dp"
                android:src="@drawable/img_1_chat_unselected" />

            <View
                android:layout_width="15dp"
                android:layout_height="match_parent"
                android:background="@android:color/transparent" />

            <!-- Profile -->
            <ImageView
                android:id="@+id/btnProfile"
                android:layout_width="0dp"
                android:layout_height="62dp"
                android:layout_margin="1dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:paddingStart="22dp"
                android:paddingTop="20dp"
                android:paddingEnd="22dp"
                android:paddingBottom="20dp"
                android:src="@drawable/img_1_profile_unselected" />

        </LinearLayout>

        <!-- Floating Add button -->
        <ImageView
            android:visibility="gone"
            android:id="@+id/menuAddStory"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="15dp"
            android:onClick="onClickAddStory"
            android:scaleType="centerInside"
            android:src="@drawable/plus_2"
            android:layout_gravity="end|center_vertical" />

    </FrameLayout>

    <!-- splash include (kept outside so it overlays on top when visible) -->
    <include
        layout="@layout/activity_splash"
        android:visibility="gone" />

</LinearLayout>

