<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/full_chatlay"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    tools:visibility="gone">

    <!-- Host bottom bar: +STREAM, +GUESTS, INTERACTION, MORE, SHARE -->
    <LinearLayout
        android:id="@+id/hostBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/streamLay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/streamImage"
                android:layout_width="48dp"
                android:layout_height="52dp"
                android:src="@drawable/ic_stream" />

            <TextView
                android:id="@+id/streamText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:letterSpacing="0.05"
                android:text="@string/title_host_stream"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cohostButtonLay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/cohostButtonImage"
                android:layout_width="48dp"
                android:layout_height="52dp"
                android:src="@drawable/ic_add_guests" />

            <TextView
                android:id="@+id/cohostButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:letterSpacing="0.05"
                android:text="@string/title_host_guests"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/interactionLay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_neon_glow" />

                <ImageView
                    android:id="@+id/interactionImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_interaction" />
            </FrameLayout>

            <TextView
                android:id="@+id/interactionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.05"
                android:text="@string/title_host_interaction"
                android:layout_marginTop="4dp"
                android:textColor="#E040FB"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/live_menu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/live_menuImage"
                android:layout_width="48dp"
                android:layout_height="52dp"
                android:src="@drawable/ic_more" />

            <TextView
                android:id="@+id/menuText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:letterSpacing="0.05"
                android:text="@string/title_host_more"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/shareLay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/shareImage"
                android:layout_width="48dp"
                android:layout_height="52dp"
                android:src="@drawable/ic_share_screen" />

            <TextView
                android:id="@+id/shareText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:letterSpacing="0.05"
                android:text="@string/title_host_share"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Viewer bottom bar: blur panel, say something, gift, wand, power, close -->
    <FrameLayout
        android:id="@+id/viewerBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="visible"
        tools:visibility="visible">

        <eightbitlab.com.blurview.BlurView
            android:id="@+id/viewerBottomBlurView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_blur_radius_24_top_transparent"
            app:blurOverlayColor="#990F172A"
            tools:targetApi="p">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="88dp"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="20dp">

                <ImageView
                    android:id="@+id/viewerCloseBtn"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentEnd="true"
                    android:padding="4dp"
                    android:src="@drawable/cancel"
                    app:tint="#FFFFFF" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_marginTop="28dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/messageLay"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_blur_radius_99"
                        android:clipToOutline="true">

                        <eightbitlab.com.blurview.BlurView
                            android:id="@+id/messageBlurView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_blur_radius_99"
                            app:blurOverlayColor="#660F172A" />

                        <TextView
                            android:id="@+id/txtcom"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:text="@string/say_something"
                            android:textColor="#99FFFFFF"
                            android:textSize="14sp" />
                    </FrameLayout>

                    <ImageView
                        android:id="@+id/viewerGuestLay"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="10dp"
                        android:contentDescription="@string/txt_guest"
                        android:src="@drawable/ic_viewer_gusts" />

                    <FrameLayout
                        android:id="@+id/btnGift"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/bg_viewer_gift_button"
                        android:clipToOutline="true">

                        <ImageView
                            android:id="@+id/gitfImage"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_gift" />

                        <TextView
                            android:id="@+id/btnGiftNew_1"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:visibility="gone" />
                    </FrameLayout>

                    <ImageView
                        android:id="@+id/viewerShareLay"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="@string/share"
                        android:src="@drawable/ic_viewer_share" />
                </LinearLayout>
            </RelativeLayout>
        </eightbitlab.com.blurview.BlurView>
    </FrameLayout>

    <!-- Legacy hidden views kept for binding compatibility -->
    <LinearLayout
        android:id="@+id/handRaiseLay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/handRaiseImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/handRaise"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/roomRequestLay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/roomRequestIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/roomRequestTV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

</LinearLayout>
