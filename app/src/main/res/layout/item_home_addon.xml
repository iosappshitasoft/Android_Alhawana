<?xml version="1.0" encoding="utf-8"?>


<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="131dp"
    android:layout_height="161dp"
    android:background="@color/primary_background_color"
    xmlns:tools="http://schemas.android.com/tools">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="7dp"
        android:elevation="5dp"
        app:strokeColor="@color/shimmerBackgroundColor"
        app:strokeWidth="0.5dp"
        app:cardCornerRadius="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <RelativeLayout
            android:id="@+id/parentLay"
            android:layout_width="match_parent"
            android:layout_height="131dp"
            android:background="@color/primary_background_color">


            <ImageView
                android:id="@+id/imageThumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/alhawana"/>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/txtViewCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_margin="6dp"
                android:fontFamily="@font/font_regular"
                android:maxLines="1"
                android:layout_alignParentEnd="true"
                android:background="@drawable/rounded_square_semi_transparent"
                android:drawableStart="@drawable/ic_live_count"
                android:text="count"
                android:textColor="@color/colorWhite"
                android:padding="3dp"
                android:gravity="center_horizontal"
                android:textSize="10sp" />


            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/txtLive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:background="@drawable/rounded_square_semi_transparent"
                android:backgroundTint="@color/colorPrimary"
                android:fontFamily="@font/font_regular"
                android:gravity="center"
                android:maxLines="1"
                android:padding="4dp"
                android:text="@string/live"
                android:layout_margin="6dp"
                android:textColor="@color/colorWhite"
                android:textSize="10sp" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/txtDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_marginStart="7dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                android:fontFamily="@font/font_regular"
                android:maxLines="1"
                android:textColor="@color/colorWhite"
                android:textSize="@dimen/text_small" />

            <LinearLayout
                android:id="@+id/container_streamDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:background="@color/transparentBG"
                android:orientation="vertical">


                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/txtTitle"
                    style="@style/TextWhiteRegular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="5dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="title"
                    android:textSize="@dimen/text_size_medium"
                    android:visibility="gone" />



            </LinearLayout>
        </RelativeLayout>

    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginBottom="5dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@+id/cvRoot"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/txtUserName"
            style="@style/TextWhiteRegular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:maxLines="1"
            tools:text="username"
            android:textSize="@dimen/text_medium" />

        <ImageView
            android:id="@+id/verified"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="2dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_verified_badge"
            android:visibility="gone" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>


