<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="10dp"
    android:id="@+id/itemLay"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RadioButton
            android:layout_marginBottom="4dp"
            android:gravity="center"
            android:button="@drawable/custom_radio_button"
            android:id="@+id/radioButtonPackage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:layout_marginBottom="4dp"
            android:layout_marginStart="10dp"
            android:id="@+id/txtPrimeTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Annual"
            android:ellipsize="end"
            android:singleLine="true"
            app:layout_constraintStart_toEndOf="@id/radioButtonPackage"
            app:layout_constraintEnd_toStartOf="@id/txtPrimePrice"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginEnd="8dp"
            android:textFontWeight="600"
            style="@style/OutfitRegularForHeadingLiteWhiteSize16"/>

        <TextView
            android:layout_marginBottom="4dp"
            android:id="@+id/txtPrimePrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$45.90/month"
            app:layout_constraintStart_toEndOf="@id/txtPrimeTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:textColor="#454545"
            android:fontFamily="@font/outfit_regular"
            android:textSize="16dp"
            android:textFontWeight="500"/>
    </androidx.constraintlayout.widget.ConstraintLayout>


    <View
        android:id="@+id/view_decor"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#454545"
        android:visibility="visible" />

</LinearLayout>
