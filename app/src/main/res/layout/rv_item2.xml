<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/view2"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:layout_marginTop="130dp">

    <FrameLayout
        android:id="@+id/cv"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">


        <com.app.Zego.internal.sdk.components.express.ZEGOVideoView
            android:id="@+id/hostView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:background="@color/colorBlack"
            android:id="@+id/blurLay">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.5"
                android:scaleType="centerCrop"
                android:id="@+id/blur_newchange"/>


            <com.makeramen.roundedimageview.RoundedImageView
                android:layout_width="70dp"
                android:src="@drawable/ic_launcher"
                app:riv_border_width="3dp"
                app:riv_border_color="@color/colorBlack"
                android:layout_height="70dp"
                android:id="@+id/blurDP"
                app:riv_corner_radius="40dp"
                android:scaleType="centerCrop"
                android:layout_centerInParent="true"/>

        </RelativeLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="5dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:background="@drawable/curved_accent"
                android:backgroundTint="@color/colorPrimary"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingEnd="10dp"
                android:paddingBottom="5dp"
                android:text="@string/text_host"
                android:textColor="@color/colorWhite"
                android:textSize="12dp"
                android:visibility="gone" />

            <View
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/gemLayHost"
                android:layout_width="wrap_content"
                android:layout_height="25dp"
                android:layout_gravity="center"
                android:layout_margin="8dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="visible">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:background="@drawable/blurred_card_background_1"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="13dp"
                        android:layout_height="15dp"
                        android:layout_gravity="center"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="9dp"
                        android:layout_marginEnd="9dp"
                        android:layout_marginBottom="9dp"
                        android:src="@drawable/new_gift" />

                    <TextView
                        android:id="@+id/tv_diamond_host"
                        style="@style/OutfitRegularForHeadingLiteWhiteSize12new"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="2dp"
                        android:layout_marginEnd="12dp"
                        android:gravity="center"
                        android:text="0"
                        android:textFontWeight="400" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/user_name1"
                    style="@style/OutfitRegularForHeadingLiteWhiteSize12new"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    android:background="@drawable/blurred_card_background_1"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="THANVI"
                    android:textFontWeight="400" />
                <ImageView
                    android:id="@+id/mic1"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@drawable/blurred_card_background_1"
                    app:tint="@color/white"
                    android:src="@drawable/ic_mic_off"
                    android:layout_gravity="center"
                    android:layout_marginTop="9dp"
                    android:layout_marginEnd="9dp"
                    android:layout_marginBottom="9dp"
                    android:layout_marginStart="9dp"/>


            </LinearLayout>
        </LinearLayout>


        <com.makeramen.roundedimageview.RoundedImageView
            android:layout_gravity="center"
            android:layout_width="70dp"
            android:src="@drawable/ic_launcher"
            app:riv_border_width="3dp"
            app:riv_border_color="@color/colorBlack"
            android:layout_height="70dp"
            android:id="@+id/userdp"
            app:riv_corner_radius="40dp"
            android:scaleType="centerCrop"
            android:layout_centerInParent="true"
            android:visibility="gone"/>


    </FrameLayout>

    <FrameLayout
        android:id="@+id/cv1"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">


        <com.app.Zego.internal.sdk.components.express.ZEGOVideoView
            android:id="@+id/cohostView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />


        <RelativeLayout
            android:id="@+id/blurLay1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/colorBlack"
            android:visibility="gone">

            <ImageView
                android:id="@+id/blur1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.5"
                android:scaleType="centerCrop" />

            <com.makeramen.roundedimageview.RoundedImageView
                android:id="@+id/blurDP1"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_centerInParent="true"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_launcher"
                android:visibility="gone"
                app:riv_border_color="@color/colorBlack"
                app:riv_border_width="3dp"
                app:riv_corner_radius="40dp" />

        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="5dp"
            android:orientation="vertical">


            <ImageView
                android:id="@+id/kickOut"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_margin="5dp"
                android:background="@drawable/call_green_round_background"
                android:backgroundTint="#4B4646"
                android:padding="5dp"
                android:visibility="gone"
                android:src="@drawable/call_cancel"
                android:tint="@color/call_red"
                app:riv_corner_radius="20dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/gemLay"
                android:layout_width="163dp"
                android:layout_height="25dp"
                android:layout_gravity="center"
                android:layout_margin="8dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="visible">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:background="@drawable/blurred_card_background_1"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="13dp"
                        android:layout_height="15dp"
                        android:layout_gravity="center"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="9dp"
                        android:layout_marginEnd="9dp"
                        android:layout_marginBottom="9dp"
                        android:src="@drawable/new_gift" />

                    <TextView
                        android:id="@+id/tv_diamond1"
                        style="@style/OutfitRegularForHeadingLiteWhiteSize12new"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="2dp"
                        android:layout_marginEnd="12dp"
                        android:gravity="center"
                        android:text="0"
                        android:textFontWeight="400" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/user_name2"
                    style="@style/OutfitRegularForHeadingLiteWhiteSize12new"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:background="@drawable/blurred_card_background_1"
                    android:gravity="center"
                    android:padding="8dp"
                    android:visibility="gone"
                    android:text="THANVI"
                    android:textFontWeight="400" />

                <ImageView
                    android:id="@+id/mic2"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@drawable/blurred_card_background_1"
                    app:tint="@color/white"
                    android:src="@drawable/ic_mic_off"
                    android:layout_gravity="center"
                    android:layout_marginTop="9dp"
                    android:layout_marginEnd="9dp"
                    android:layout_marginBottom="9dp"
                    android:layout_marginStart="9dp"/>


                <com.makeramen.roundedimageview.RoundedImageView
                    android:id="@+id/userProfileImageNew1"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:layout_marginLeft="5dp"
                    android:adjustViewBounds="true"
                    android:cropToPadding="false"
                    android:padding="3dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/image_logo"
                    android:visibility="gone"
                    app:riv_mutate_background="true"
                    app:riv_oval="true" />

            </LinearLayout>


        </LinearLayout>

    </FrameLayout>

</LinearLayout>