<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/repostEditOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <LinearLayout
        android:id="@+id/repostPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="20dp"
        android:layout_gravity="center"
        android:background="@android:color/transparent">

        <!-- Heading -->
        <TextView
            android:id="@+id/repostHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_yr_repost"
            android:textSize="18sp"
            android:textColor="@android:color/white"

            android:paddingBottom="14dp" />

        <!-- WHITE BACKGROUND BOX -->
        <LinearLayout
            android:id="@+id/editContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_white_bg"
            android:padding="10dp">

            <!-- ROW 1: IMAGE + EDITTEXT -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:orientation="horizontal"
                android:gravity="top">

                <com.makeramen.roundedimageview.RoundedImageView
                    android:id="@+id/repostUserImage"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/filter_sample_image"
                    android:scaleType="centerCrop"
                    app:riv_corner_radius="32dp" />

<!--                <EditText-->
<!--                    android:id="@+id/repostEditText"-->
<!--                    android:layout_width="0dp"-->
<!--                    android:layout_height="match_parent"-->
<!--                    android:layout_weight="1"-->
<!--                    android:hint="Say something..."-->
<!--                    android:gravity="top"-->
<!--                    android:paddingStart="10dp"-->
<!--                    android:textColor="#000"-->
<!--                    android:textColorHint="#888"-->
<!--                    android:background="@android:color/transparent" />-->

                <EditText
                    android:lineSpacingExtra="5dp"
                    android:id="@+id/repostEditText"
                    style="@style/TextWhiteRegular"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:gravity="start"
                    android:paddingStart="10dp"
                    android:textColor="#000"
                    android:textDirection="locale"
                    android:layoutDirection="locale"
                    android:hint="Say something"
                    android:maxLength="50"
                    android:textColorHint="#888" />

            </LinearLayout>

            <!-- ROW 2: EMOJI + ADD BUTTON (INSIDE SAME WHITE BG) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:orientation="horizontal"
                android:gravity="center_vertical|end"
                android:paddingTop="5dp">

                <ImageView
                    android:id="@+id/emojiButton"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/lose_emoji"
                    android:padding="4dp"
                    android:visibility="gone"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:id="@+id/repostAddBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:paddingHorizontal="22dp"
                    android:paddingVertical="8dp"
                    android:textColor="@android:color/white"
                    android:background="@drawable/rounded_add_btn" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
