<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:background="#4D181A20"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/btnCancel"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="32dp"
        android:background="?selectableItemBackgroundBorderless"
        android:padding="5dp"
        android:src="@drawable/mls_icon_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/add_topic"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:drawableStart="@drawable/new_hashtags"
        android:drawablePadding="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnCancel"
        android:layout_marginTop="88dp"
        android:layout_marginEnd="24dp"
        android:id="@+id/topicTV"/>


    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#33FFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:id="@+id/titleMCV"
        app:layout_constraintTop_toBottomOf="@id/topicTV">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <com.makeramen.roundedimageview.RoundedImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/filter_sample_image"
                    android:scaleType="centerCrop"
                    app:riv_oval="true"
                    app:riv_border_width="0dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:id="@+id/userImage"/>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/new_edit"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/userImage"
                    android:layout_marginTop="-12dp"
                    android:background="@drawable/bg_primary_curved_outline"
                    android:backgroundTint="#000000"
                    android:padding="2dp"
                    android:tint="@color/white"
                    android:foreground="?selectableItemBackgroundBorderless"
                    android:id="@+id/btnEdit"/>

            </androidx.constraintlayout.widget.ConstraintLayout>


            <EditText
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:hint="@string/add_a_topic"
                android:layout_marginHorizontal="24dp"
                android:textSize="18sp"
                android:textColor="@color/white"
                android:textColorHint="@color/white"
                android:background="@android:color/transparent"
                android:drawableEnd="@drawable/new_edit_pencil"
                android:drawablePadding="12dp"
                android:id="@+id/edtTitle"
                android:textCursorDrawable="@null"
                android:imeOptions="actionDone"
                android:inputType="textMultiLine"
                android:maxLength="80"
                android:maxLines="4"
                android:textAlignment="viewStart"/>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:id="@+id/tipsLay"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/titleMCV"
        app:cardBackgroundColor="#33FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="10dp"
            android:paddingHorizontal="16dp"
            android:orientation="vertical">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:background="?selectableItemBackgroundBorderless"
                android:layout_gravity="end|top"
                android:id="@+id/btnCancelTips"
                android:src="@drawable/mls_icon_close"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/continue_your_live_journey_and_get_the_full_live_experience"
                android:textColor="@color/white"
                android:layout_marginBottom="16dp"
                android:layout_marginTop="4dp"
                android:textSize="16sp"/>

        </LinearLayout>


    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:gravity="center"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="32dp"
        android:layout_marginHorizontal="15dp"
        app:layout_constraintBottom_toTopOf="@id/btnGoLive">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:gravity="center"
            android:weightSum="5">

            <LinearLayout
                android:layout_width="0dp"
                android:id="@+id/flipLay"
                android:layout_weight="1"
                android:clickable="true"
                android:background="?selectableItemBackgroundBorderless"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:id="@+id/flipIcon"
                    android:src="@drawable/new_camera_flip"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/flip"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:id="@+id/cameraLay"
                android:layout_weight="1"
                android:clickable="true"
                android:background="?selectableItemBackgroundBorderless"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:id="@+id/cameraIcon"
                    android:src="@drawable/new_camera_shutter"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/camera"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:id="@+id/micLay"
                android:clickable="true"
                android:background="?selectableItemBackgroundBorderless"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:id="@+id/micIcon"
                    android:src="@drawable/new_microphone"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text="@string/mic"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:id="@+id/liveCenterLay"
                android:clickable="true"
                android:background="?selectableItemBackgroundBorderless"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/new_live_center"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/live_center"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:singleLine="true"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>

           <!-- <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:id="@+id/liveFilterEffect"
                android:clickable="true"
                android:background="?selectableItemBackgroundBorderless"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:visibility="visible"
                android:orientation="vertical">

                <com.cashgate.chobi.Zego.pkbattle.internal.utils.BeautyButton
                    android:id="@+id/preview_beauty"
