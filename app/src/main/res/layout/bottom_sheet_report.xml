<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_alignParentTop="true"
    android:background="@color/colorBlack"
    android:layout_gravity="top"
    android:orientation="vertical">

    <View
        android:layout_width="30dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bottom_sheet_close"
        android:visibility="gone"/>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/toolbar_start_margin"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/back"
            android:visibility="visible"
            app:tint="@color/white" />



        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/optionLay"
            android:layout_toEndOf="@+id/btnBack"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtTitle"
                style="@style/TextBlackRegular"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:text="@string/report_video"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:gravity="center"
                android:textSize="@dimen/toolbar_title" />

            <TextView
                android:id="@+id/txtSubTitle"
                style="@style/TextBlackLight"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:gravity="center"
                android:textSize="@dimen/toolbar_sub_title"
                android:visibility="gone" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/optionLay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:orientation="horizontal">


            <ImageView
                android:id="@+id/btnClose"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:padding="10dp"
                android:src="@drawable/close_icon"
                android:visibility="visible" />

        </LinearLayout>

    </RelativeLayout>

    <!--    SelectResaonLay-->
    <RelativeLayout
        android:id="@+id/selectResonLay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/reportView"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:overScrollMode="never"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_user_report" />

    </RelativeLayout>

    <!--    SelectSubResaonLay-->
    <RelativeLayout
        android:id="@+id/selectSubResonLay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/reportView1"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:overScrollMode="never"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_user_report" />

    </RelativeLayout>

    <!--    SelectSubResaonLay2-->
    <RelativeLayout
        android:id="@+id/selectSubResonLay2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/reportView2"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:overScrollMode="never"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_user_report" />

    </RelativeLayout>

    <!--    SubmitLay-->
    <RelativeLayout
        android:id="@+id/submitLay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="invisible">
        <LinearLayout
            android:id="@+id/titleLay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:orientation="horizontal"
            android:paddingStart="5dp"
            android:paddingTop="20dp"
            android:paddingEnd="5dp"
            android:paddingBottom="15dp">

            <TextView
                android:id="@+id/reportTitle"
                style="@style/OutfitRegularForHeadingWhiteSize16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="12dp"
                android:padding="5dp"
                android:visibility="gone"
                android:text=""
                android:textAlignment="viewStart"
                android:textSize="16sp"
                android:fontFamily="@font/outfit_medium"
                android:textFontWeight="500" />

        </LinearLayout>

        <TextView
            android:id="@+id/reportReason"
            android:layout_below="@id/titleLay"
            style="@style/OutfitRegularForHeadingWhiteSize16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="12dp"
            android:padding="5dp"
            android:text=""
            android:textAlignment="viewStart"
            android:textSize="16sp"
            android:fontFamily="@font/outfit_medium"
            android:textFontWeight="500" />


        <LinearLayout
            android:id="@+id/textBoxLay"
            android:layout_below="@id/reportReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginHorizontal="10dp"
            android:paddingStart="17dp"
            android:paddingEnd="17dp"
            android:background="@drawable/state_default_bg"
            android:layout_marginBottom="8dp">

            <com.hendraanggrian.appcompat.socialview.widget.SocialAutoCompleteTextView
                android:id="@+id/reportEditTxt"
                style="@style/TextBlackRegular1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:completionThreshold="1"
                android:dropDownAnchor="@id/dropDownAnchor"
                android:focusable="true"
                android:fontFamily="@font/outfit_medium"
                android:hint="@string/report_user"
                android:textColorHint="@color/bottomsheet_textcolor"
                android:imeOptions="actionNext"
                android:inputType="textMultiLine"
                android:gravity="start"
                android:textSize="16sp"
                android:layout_marginTop="14dp"
                android:textDirection="locale"
                android:maxLength="250"
                app:hashtagColor="@color/colorPrimary"
                app:socialFlags="hashtag" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/personBoxLay"
            android:layout_below="@id/textBoxLay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginHorizontal="10dp"
            android:paddingStart="17dp"
            android:paddingEnd="17dp"
            android:background="@drawable/state_default_bg"
            android:layout_marginBottom="8dp">

            <AutoCompleteTextView
                android:id="@+id/personEditTxt"
                style="@style/TextBlackRegular1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:completionThreshold="1"
                android:focusable="true"
                android:fontFamily="@font/outfit_medium"
                android:hint="@string/enter_user_name"
                android:textColorHint="@color/bottomsheet_textcolor"
                android:imeOptions="actionNext"
                android:inputType="textMultiLine"
                android:gravity="start"
                android:textSize="16sp"
                android:layout_marginTop="14dp"
                android:textDirection="locale"
                android:maxLength="250"
                app:hashtagColor="@color/colorPrimary"
                app:socialFlags="hashtag" />

        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="20dp"
            android:layout_alignParentBottom="true"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnReport"
                style="@style/ButtonPrimaryBold1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="0dp"
                android:fontFamily="@font/outfit_regular"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/submit"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:textSize="16sp"
                android:textAllCaps="false"
                android:textColor="@color/colorWhite"
                android:backgroundTint="@color/colorPrimary"/>

        </LinearLayout>



    </RelativeLayout>


</LinearLayout>