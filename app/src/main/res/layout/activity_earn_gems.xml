<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/parentLay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/colorBlack">

    <include
        android:id="@+id/includeHeader"
        layout="@layout/activity_toolbar_black" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/toolbar"
        android:visibility="gone"
        android:background="@color/colorDivider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/adView"
        android:layout_below="@+id/includeHeader"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:layout_marginTop="30dp"
            android:orientation="vertical">
            <TextView
                style="@style/TextBlackRegular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="30dp"
                android:gravity="center"
                android:fontFamily="@font/outfit_semibold"
                android:lineSpacingExtra="5dp"
                android:lines="2"
                android:textColor="@color/colorWhite"
                android:text="@string/invite_friends_reward"
                android:textSize="20sp" />
            <ImageView
                android:layout_width="250dp"
                android:layout_height="250dp"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="30dp"
                android:adjustViewBounds="false"
                android:src="@drawable/invite_friend_svg"
                android:visibility="visible" />




           <!-- <TextView
                android:id="@+id/txtGemsDesc"
                style="@style/TextBlackRegular"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="30dp"
                android:gravity="center"
                android:textColor="#A8A8A8"
                android:lineSpacingExtra="5dp"
                android:fontFamily="@font/outfit_regular"
                android:text="@string/free_gems_content"
                android:textSize="12sp" />-->

            <TextView
                android:id="@+id/txtGemsDesc"
                style="@style/TextBlackRegular"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="30dp"
                android:gravity="center"
                android:textColor="#A8A8A8"
                android:lineSpacingExtra="5dp"
                android:fontFamily="@font/outfit_regular"
                android:text="@string/new_invite_text"
                android:textSize="12sp" />


            <Button
                android:id="@+id/btnRefer"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginBottom="10dp"
                android:layout_marginTop="50dp"
                android:fontFamily="@font/outfit_semibold"
                android:letterSpacing="0"
                android:text="@string/refer_your_friends"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:visibility="visible"
                android:insetTop="2dp"
                android:insetBottom="2dp"
                app:cornerRadius="@dimen/corner_radius"
                android:background="@drawable/bg_card_curve_btn"
                />


            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/btnWatchVideo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="30dp"
                android:fontFamily="@font/outfit_semibold"
                android:gravity="center"
                android:insetTop="2dp"
                android:insetBottom="2dp"
                android:letterSpacing="0"
                android:text="@string/watch_video"
                android:textAllCaps="false"
                android:textColor="@color/colorPrimary"
                android:textSize="16sp"
                android:visibility="visible"
                app:cornerRadius="@dimen/corner_radius"
                app:rippleColor="@color/colorWhite" />


            <TextView
                android:id="@+id/txtVideoTime"
                style="@style/TextPrimaryLight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@android:color/holo_red_dark"
                android:textSize="@dimen/text_normal"
                android:visibility="gone" />

        </LinearLayout>

    </ScrollView>

    <include
        layout="@layout/layout_adview" />

</RelativeLayout>