<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    tools:context=".EditFieldActivity"
    android:fitsSystemWindows="true">

    <!-- Top Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/black"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/cancelButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/saveButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/save"
            android:textColor="@color/colorPrimary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Content Section -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Name Section -->
        <LinearLayout
            android:id="@+id/nameSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/nameTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/name"
                android:textColor="@android:color/white"
                android:textSize="24sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/nameDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/seven_day"
                android:textColor="@android:color/darker_gray"
                android:textSize="14sp"
                android:layout_marginTop="8dp"/>

            <LinearLayout
                android:id="@+id/nameInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_edit_text_rounded"
                android:padding="8dp">

                <EditText
                    android:id="@+id/nameEditText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="@string/enter_name"
                    android:text=""
                    android:textColor="@android:color/white"
                    android:textColorHint="@android:color/darker_gray"
                    android:textSize="16sp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:inputType="textCapWords"/>

                <ImageView
                    android:id="@+id/clearNameTextButton"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/new_close_cancel"
                    app:tint="@android:color/darker_gray"
                    android:layout_marginStart="8dp"
                    android:visibility="gone"
                    android:contentDescription="Clear Text" />

            </LinearLayout>

            <TextView
                android:id="@+id/nameCharCountText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0/30"
                android:textColor="@android:color/darker_gray"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                android:layout_gravity="end"/>

        </LinearLayout>

        <!-- Username Section -->
        <LinearLayout
            android:id="@+id/usernameSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/usernameTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/username"
                android:textColor="@android:color/white"
                android:textSize="24sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/usernameDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/user_name_change_alert"
                android:textColor="@android:color/darker_gray"
                android:textSize="14sp"
                android:layout_marginTop="8dp"/>

            <LinearLayout
                android:id="@+id/usernameInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_edit_text_rounded"
                android:padding="8dp">

                <EditText
                    android:id="@+id/usernameEditText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="username"
                    android:text=""
                    android:textColor="@android:color/white"
                    android:textColorHint="@android:color/darker_gray"
                    android:textSize="16sp"
                    android:inputType="textNoSuggestions"/>

                <ImageView
                    android:id="@+id/validationIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/new_close_cancel"
                    app:tint="@android:color/holo_green_dark"
                    android:visibility="gone"
                    android:contentDescription="Validation Status" />

                <ImageView
                    android:id="@+id/clearUsernameTextButton"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/new_close_cancel"
                    app:tint="@android:color/darker_gray"
                    android:layout_marginStart="8dp"
                    android:visibility="gone"
                    android:contentDescription="Clear Text" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/profileLinkSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">
                <TextView
                    android:layout_weight="1"
                    android:id="@+id/profileLinkText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="www.tiktok.com/@nishadvythiri"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"
                    android:visibility="visible"/>

                <TextView
                    android:id="@+id/usernameCharCountText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0/24"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"
                    android:layout_gravity="end"/>
            </LinearLayout>


        </LinearLayout>

        <!-- Bio Section -->
        <LinearLayout
            android:id="@+id/bioSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/bioTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bio"
                android:textColor="@android:color/white"
                android:textSize="24sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/bioDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/txt_edit_bio"
                android:textColor="@android:color/darker_gray"
                android:textSize="14sp"
                android:layout_marginTop="8dp"/>

            <EditText
                android:id="@+id/bioEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="100dp"
                android:gravity="top|start"
                android:background="@drawable/bg_edit_text_rounded"
                android:hint="@string/txt_enter_bio"
                android:text=""
                android:textColor="@android:color/white"
                android:textColorHint="@android:color/darker_gray"
                android:textSize="16sp"
                android:inputType="textMultiLine|textCapSentences"
                android:padding="8dp"
                android:layout_marginTop="16dp"/>

            <TextView
                android:id="@+id/bioCharCountText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0/160"
                android:textColor="@android:color/darker_gray"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                android:layout_gravity="end"/>

            <Button
                android:id="@+id/mentionButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mention"
                android:textColor="@android:color/white"
                android:backgroundTint="@color/colorPrimary"
                android:layout_marginTop="16dp"
                android:visibility="gone"/>

        </LinearLayout>

        <!-- Mobile Number Section -->
        <LinearLayout
            android:id="@+id/mobileNumberSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/mobileNumberTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mobile Number"
                android:textColor="@android:color/white"
                android:textSize="24sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/mobileNumberDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="This will be used for account verification and security."
                android:textColor="@android:color/darker_gray"
                android:textSize="14sp"
                android:layout_marginTop="8dp"/>

            <LinearLayout
                android:id="@+id/mobileNumberInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_edit_text_rounded"
                android:padding="8dp">

                <EditText
                    android:id="@+id/mobileNumberEditText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Enter your mobile number"
                    android:text=""
                    android:textColor="@android:color/white"
                    android:textColorHint="@android:color/darker_gray"
                    android:textSize="16sp"
                    android:inputType="phone"/>

                <ImageView
                    android:id="@+id/clearMobileNumberTextButton"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/new_close_cancel"
                    app:tint="@android:color/darker_gray"
                    android:layout_marginStart="8dp"
                    android:visibility="gone"
                    android:contentDescription="Clear Text" />

            </LinearLayout>

        </LinearLayout>

        <!-- Gender Section -->
        <LinearLayout
            android:id="@+id/genderSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/genderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gender"
                android:textColor="@android:color/white"
                android:textSize="24sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/genderDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select your gender."
                android:textColor="@android:color/darker_gray"
                android:textSize="14sp"
                android:layout_marginTop="8dp"/>

            <LinearLayout
                android:id="@+id/genderInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_edit_text_rounded"
                android:padding="8dp">

                <EditText
                    android:id="@+id/genderEditText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Enter your gender"
                    android:text=""
                    android:textColor="@android:color/white"
                    android:textColorHint="@android:color/darker_gray"
                    android:textSize="16sp"
                    android:inputType="textCapWords"/>

                <ImageView
                    android:id="@+id/clearGenderTextButton"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/new_close_cancel"
                    app:tint="@android:color/darker_gray"
                    android:layout_marginStart="8dp"
                    android:visibility="gone"
                    android:contentDescription="Clear Text" />

            </LinearLayout>

        </LinearLayout>

        <!-- Date of Birth Section -->
        <LinearLayout
            android:id="@+id/dobSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/dobTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Date of Birth"
                android:textColor="@android:color/white"
                android:textSize="24sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/dobDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your date of birth will be used to verify your age."
                android:textColor="@android:color/darker_gray"
                android:textSize="14sp"
                android:layout_marginTop="8dp"/>

            <LinearLayout
                android:id="@+id/dobInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_edit_text_rounded"
                android:padding="8dp">

                <EditText
                    android:id="@+id/dobEditText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Select your date of birth"
                    android:text=""
                    android:textColor="@android:color/white"
                    android:textColorHint="@android:color/darker_gray"
                    android:textSize="16sp"
                    android:focusable="false"
                    android:clickable="true"
                    android:inputType="none"/>

                <ImageView
                    android:id="@+id/clearDobTextButton"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/new_close_cancel"
                    app:tint="@android:color/darker_gray"
                    android:layout_marginStart="8dp"
                    android:visibility="gone"
                    android:contentDescription="Clear Text" />

            </LinearLayout>

        </LinearLayout>

        <!-- PayPal ID Section -->
        <LinearLayout
            android:id="@+id/paypalIdSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/paypalIdTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PayPal ID"
                android:textColor="@android:color/white"
                android:textSize="24sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/paypalIdDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enter your PayPal ID to receive payments."
                android:textColor="@android:color/darker_gray"
                android:textSize="14sp"
                android:layout_marginTop="8dp"/>

            <LinearLayout
                android:id="@+id/paypalIdInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_edit_text_rounded"
                android:padding="8dp">

                <EditText
                    android:id="@+id/paypalIdEditText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="@string/enter_yourpaypal_id"
                    android:text=""
                    android:textColor="@android:color/white"
                    android:textColorHint="@android:color/darker_gray"
                    android:textSize="16sp"
                    android:inputType="textEmailAddress"/>

                <ImageView
                    android:id="@+id/clearPaypalIdTextButton"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/new_close_cancel"
                    app:tint="@android:color/darker_gray"
                    android:layout_marginStart="8dp"
                    android:visibility="gone"
                    android:contentDescription="Clear Text" />

            </LinearLayout>

        </LinearLayout>

        <!-- Link Section -->
        <LinearLayout
            android:id="@+id/linkSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/topBarLink"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/backArrow"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/back_arrow"
                    android:contentDescription="Back"
                    app:tint="@android:color/white"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/enter_links"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    app:layout_constraintStart_toEndOf="@id/backArrow"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_marginStart="16dp" />


            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp"
                android:id="@+id/instaMainLay">
                <TextView
                    android:id="@+id/instagramLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/enter_instagram_link"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:drawableStart="@drawable/instagram16"
                    android:drawablePadding="8dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />
                <TextView
                    android:id="@+id/instagramlinkValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/enter_addlink"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="16sp"
                    android:textAlignment="viewEnd"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintStart_toEndOf="@id/instagramLabel"
                    app:layout_constraintEnd_toStartOf="@id/instagramlinkArrow"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintHorizontal_bias="1.0" />
                <ImageView
                    android:id="@+id/instagramlinkArrow"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/arrow_right"
                    android:contentDescription="Add Link"
                    app:tint="@android:color/darker_gray"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp"
                android:id="@+id/youtubeMainLay">
                <TextView
                    android:id="@+id/youtubelinkLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/enter_youtube_link"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:drawableStart="@drawable/youtube"
                    android:drawablePadding="8dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />
                <TextView
                    android:id="@+id/youtubelinkValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/enter_addlink"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="16sp"
                    android:textAlignment="viewEnd"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintStart_toEndOf="@id/youtubelinkLabel"
                    app:layout_constraintEnd_toStartOf="@id/youtubelinkArrow"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintHorizontal_bias="1.0" />
                <ImageView
                    android:id="@+id/youtubelinkArrow"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/arrow_right"
                    android:contentDescription="@string/enter_addlink"
                    app:tint="@android:color/darker_gray"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/datalinkSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/linkTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@android:color/white"
                    android:textSize="24sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/linkDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@android:color/darker_gray"
                    android:textSize="14sp"
                    android:visibility="gone"
                    android:layout_marginTop="8dp"/>

                <LinearLayout
                    android:id="@+id/linkInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_edit_text_rounded"
                    android:padding="8dp">

                    <EditText
                        android:id="@+id/linkEditText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint=""
                        android:text=""
                        android:textColor="@android:color/white"
                        android:textColorHint="@android:color/darker_gray"
                        android:textSize="16sp"
                        android:inputType="textUri"/>

                    <ImageView
                        android:id="@+id/clearlinkTextButton"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
