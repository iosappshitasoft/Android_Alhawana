        <LinearLayout
            android:id="@+id/userLay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/rounded_background1"
            android:orientation="horizontal"
            android:visibility="visible"
            android:padding="2dp"
            app:layout_constraintBottom_toBottomOf="@+id/ivThumb"
            app:layout_constraintStart_toStartOf="@+id/ivThumb"
            android:layout_marginStart="12dp"
            android:layout_marginBottom="14dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivUser"
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:adjustViewBounds="true"
                android:background="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/default_profile_image"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.RoundedImageView10" />

            <TextView
                android:id="@+id/userName"
                style="@style/OutfitRegularForHeadingWhiteSize10"
                android:layout_width="50dp"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="4dp"
                android:gravity="center"
                android:maxLines="1"
                android:textAlignment="viewStart"
                android:layout_marginEnd="8dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:textSize="12sp"
                android:text="Test"
                android:textFontWeight="500" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <RelativeLayout
        android:id="@+id/headerLinearLay"
        android:layout_height="wrap_content"
        android:layout_width="fill_parent"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="-10dp"
        android:background="#80000000"
        android:layoutDirection="ltr"
        android:textDirection="ltr"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:ignore="MissingConstraints">

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/avatarImageView"
            android:layout_width="20dp"
            android:layout_height="20dp"
            app:lottie_autoPlay="true"
            app:lottie_fileName="processing.json"
            android:layoutDirection="ltr"
            app:lottie_loop="true"
            app:lottie_renderMode="software"
            app:lottie_speed="1" />
        <TextView
            android:id="@+id/usernameTextView"
            android:text="@string/Optim_text"
            android:layout_toRightOf="@id/avatarImageView"
            android:layout_centerVertical="true"
            android:textColor="@color/white"
            android:textSize="@dimen/text_small"
            android:textDirection="ltr"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"></TextView>
    </RelativeLayout>


</androidx.constraintlayout.widget.ConstraintLayout>

