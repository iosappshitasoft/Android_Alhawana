<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/itemLay"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_alignParentStart="true"
    android:layout_gravity="start"
    android:layout_marginStart="5dp"
    android:layout_marginBottom="5dp">

    <com.makeramen.roundedimageview.RoundedImageView
        android:id="@+id/img_commenter"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:adjustViewBounds="true"
        android:scaleType="centerCrop"
        app:riv_corner_radius="65dp"
        android:padding="7dp"
        app:riv_mutate_background="true" />

    <View
        android:layout_width="8dp"
        android:layout_height="match_parent"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="5dp"
        android:orientation="vertical"
        android:layout_gravity="center"
        android:gravity="center"
        android:background="@drawable/blurred_card_background_1">


        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/txtJoined"
            style="@style/OutfitRegularForHeadingLiteWhiteSize12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:padding="2dp"
            android:text="username"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:textFontWeight="500"
            android:textAlignment="viewStart"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:padding="2dp"
            android:text="@string/text_joined"
            android:textFontWeight="400"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:id="@+id/txt_joined_text"
            android:textAlignment="viewStart"
            style="@style/OutfitRegularForHeadingLiteWhiteSize12" />
    </LinearLayout>

</LinearLayout>