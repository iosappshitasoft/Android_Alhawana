<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/LView"
    android:layout_alignParentBottom="true"
    android:layout_gravity="bottom"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    app:layout_constraintBottom_toBottomOf="parent"
    tools:ignore="ContentDescription,UnusedAttribute">

    <com.crystal.crystalrangeseekbar.widgets.CrystalRangeSeekbar
        android:id="@+id/range_seek_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"
        android:elevation="4dp"
        android:padding="7dp"
        app:bar_color="@android:color/transparent"
        app:bar_highlight_color="@android:color/transparent"
        app:data_type="_integer"
        app:left_thumb_image="@drawable/ic_min_seek"
        app:right_thumb_image="@drawable/ic_max_seek" />

    <com.crystal.crystalrangeseekbar.widgets.CrystalSeekbar
        android:id="@+id/seekbar_controller"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:elevation="4dp"
        android:padding="8dp"
        app:bar_color="@android:color/transparent"
        app:bar_highlight_color="@android:color/transparent"
        app:left_thumb_image="@drawable/ic_vertical_line" />

    <LinearLayout
        android:id="@+id/view_image"
        style="@style/LView"
        android:layout_alignParentTop="true"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"
        android:background="@drawable/bg_card_curve1">

        <ImageView
            android:id="@+id/image_one"
            style="@style/ImageTrim"
            android:background="@color/colorBlack"
            android:padding="3dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.RoundedImageView" />

        <ImageView
            android:id="@+id/image_two"
            style="@style/ImageTrim"
            android:background="@color/colorBlack"
            android:padding="3dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.RoundedImageView" />

        <ImageView
            android:id="@+id/image_three"
            style="@style/ImageTrim"
            android:background="@color/colorBlack"
            android:padding="3dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.RoundedImageView" />

        <ImageView
            android:id="@+id/image_four"
            style="@style/ImageTrim"
            android:background="@color/colorBlack"
            android:padding="3dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.RoundedImageView" />

        <ImageView
            android:id="@+id/image_five"
            style="@style/ImageTrim"
            android:background="@color/colorBlack"
            android:padding="3dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.RoundedImageView" />

        <ImageView
            android:id="@+id/image_six"
            style="@style/ImageTrim"
            android:background="@color/colorBlack"
            android:padding="3dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.RoundedImageView" />

        <ImageView
            android:id="@+id/image_seven"
            style="@style/ImageTrim"
            android:background="@color/colorBlack"
            android:padding="3dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.RoundedImageView" />

        <ImageView
            android:id="@+id/image_eight"
            style="@style/ImageTrim"
            android:background="@color/colorBlack"
            android:padding="3dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.RoundedImageView" />
    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/view_image"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp">

        <TextView
            android:id="@+id/txt_start_duration"
            style="@style/TxtRgStyle22"
            android:layout_alignParentStart="true"
            android:layout_gravity="bottom"
            android:textColor="#80FFFFFF"
            android:textSize="14sp"
            android:visibility="visible"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txt_trim_duration"
            style="@style/TxtRgStyle22"
            android:layout_gravity="bottom"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:textColor="#80FFFFFF"
            android:textSize="14sp"
            android:visibility="visible"
            app:layout_constraintEnd_toStartOf="@+id/txt_end_duration"
            app:layout_constraintStart_toEndOf="@+id/txt_start_duration"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txt_end_duration"
            style="@style/TxtRgStyle22"
            android:layout_alignParentEnd="true"
            android:textColor="#80FFFFFF"
            android:textSize="14sp"
            android:visibility="visible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</RelativeLayout>