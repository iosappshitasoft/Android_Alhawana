    <LinearLayout
        android:id="@+id/tab_lay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="5dp"
        android:layout_alignParentBottom="true">

       <LinearLayout
        android:id="@+id/lay_bottom_details"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:layout_marginLeft="5dp"
        android:layout_marginRight="5dp"
        android:layout_marginBottom="15dp"
       >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:layout_weight="1"
            android:layout_marginRight="5dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:background="@drawable/bg_primary_curved">

            <EditText
                android:layout_weight="1"
                android:id="@+id/edtMessage"
                style="@style/TextWhiteLight"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical"
                android:background="@null"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:hint="@string/type_your_message"
                android:inputType="textCapSentences"
                android:isScrollContainer="true"
                android:padding="3dp"
                android:layout_marginLeft="7dp"
                android:textColorHint="#FFFFFF"
                android:textSize="@dimen/text_medium"
                />

            <ImageView
                android:id="@+id/btnSend"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="5dp"
                android:src="@drawable/mls_send"
                android:visibility="visible"
                android:layout_marginLeft="2dp"
                android:layout_marginRight="2dp"
                android:tint="@color/white" />
            <ImageView
                android:id="@+id/btnGift"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:padding="5dp"
                android:src="@drawable/mls_gift"
                android:visibility="gone"
                android:layout_marginLeft="2dp"
                android:layout_marginRight="2dp"
                android:tint="@color/white"/>
<!--            <LinearLayout-->
<!--                android:id="@+id/handsJoinLay"-->
<!--                android:layout_width="wrap_content"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:layout_gravity="center"-->
<!--                android:gravity="center"-->
<!--                android:layout_marginLeft="2dp"-->
<!--                android:layout_marginRight="2dp">-->

<!--                <ImageView-->
<!--                    android:visibility="gone"-->
<!--                    android:id="@+id/handView"-->
<!--                    android:layout_width="30dp"-->
<!--                    android:layout_height="30dp"-->
<!--                    android:layout_centerVertical="true"-->
<!--                    android:padding="5dp"-->
<!--                    android:src="@drawable/mls_hand"-->
<!--                    android:tint="@color/colorWhite" />-->


<!--            </LinearLayout>-->

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:padding="5dp"
                android:src="@drawable/heart"
                android:layout_marginRight="5dp"
                android:id="@+id/img_hearty"/>
            <ImageView
                android:id="@+id/more"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:padding="5dp"
                android:visibility="gone"
                android:src="@drawable/new_more"
                android:layout_marginRight="5dp"
                >

            </ImageView>
            <LinearLayout
                android:visibility="gone"
                android:id="@+id/lay_invite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:layout_marginLeft="2dp"
                android:layout_marginRight="2dp">

                <ImageView
                    android:id="@+id/invite"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_centerVertical="true"
                    android:padding="5dp"
                    android:src="@drawable/mls_hand"
                    android:tint="@color/colorWhite" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

        <LinearLayout
            android:id="@+id/newtab_lay"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:weightSum="4">
            <ImageView
                android:id="@+id/newcomment_Lay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/colorBlack"
                android:src="@drawable/new_more"
                android:padding="12dp"
                android:layout_weight="1"
               android:tint="@color/colorWhite"></ImageView>
            <ImageView
                android:id="@+id/newViewers_lay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/colorBlack"
                android:padding="12dp"
                android:src="@drawable/new_friend"
                android:layout_weight="1"
                android:tint="@color/colorWhite"></ImageView>
            <ImageView
                android:id="@+id/newShare_lay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/colorBlack"
                android:src="@drawable/new_share"
                android:padding="12dp"
                android:layout_weight="1"
                android:tint="@color/colorWhite"></ImageView>
            <ImageView
                android:id="@+id/img_close_"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/colorBlack"
                android:src="@drawable/new_power"
                android:padding="12dp"
                android:layout_weight="1"
                android:tint="@color/colorWhite"></ImageView>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/more_lay"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@color/colorBlack"
            android:visibility="gone"
            >
            <ImageView
                android:id="@+id/internalShare"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@color/colorBlack"
                android:padding="12dp"
                android:src="@drawable/new_friendshare"
                android:tint="@color/colorWhite"></ImageView>
            <ImageView
                android:id="@+id/externalShare"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@color/colorBlack"
                android:layout_marginStart="10dp"
                android:src="@drawable/new_share"
                android:padding="12dp"

                android:tint="@color/colorWhite"></ImageView>
            <ImageView
                android:id="@+id/userClose"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginStart="10dp"
                android:background="@color/colorBlack"
                android:src="@drawable/new_power"
                android:padding="12dp"
                android:tint="@color/colorWhite"></ImageView>
        </LinearLayout>

    </LinearLayout>

    <ImageView
        android:id="@+id/img_animation_gif"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="100dp"
        />

    <com.opensource.svgaplayer.SVGAImageView
        android:id="@+id/svgaImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="100dp"
        app:autoPlay="true"
        app:loopCount="2"/>

    <com.app.addon.livestream.external.heartlayout.HeartLayout
        android:id="@+id/heartLay"
        android:layout_width="110dp"
        android:layout_alignParentEnd="true"
        android:layout_height="match_parent"
        android:layout_marginBottom="70dp"/>
</RelativeLayout>


