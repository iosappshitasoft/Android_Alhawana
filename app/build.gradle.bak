plugins {
    id("com.android.application")
    id('kotlin-android')
    id("kotlin-parcelize")
    id("com.google.gms.google-services")
    id("com.jakewharton.butterknife")
    alias(libs.plugins.kotlin.compose)
}

/**x
 * Version code update reference link
 https://medium.com/@manas/manage-your-android-app-s-versioncode-versionname-with-gradle-7f9c5dcf09bf
 */
ext {
    applicationId = "com.app.alhawanajd"
    appName = "Alhawanajd"
    minSdkVersion = 24 // Lollipop
    compileSdkVersion = 36 // Android API 36
    versionMajor = 53    // major changes
    versionMinor = 12    // minor changes
    versionPatch = 20  // bug fixes
    versionClassifier = ""    // version classifier eg. alpha (a), beta (b)
    isSnapshot = false   // test build before production
}

android {

    signingConfigs {
        debug {
            storeFile file('alhawanajd.jks')
            storePassword 'alhawanajd'
            keyAlias 'alhawanajd'
            keyPassword 'alhawanajd'
        }
        release {
            storePassword 'alhawanajd'
            keyAlias 'alhawanajd'
            keyPassword 'alhawanajd'
            storeFile file('alhawanajd.jks')
        }
    }

    compileSdkVersion project.ext.compileSdkVersion
    defaultConfig {
        applicationId(project.ext.applicationId)
        minSdkVersion(project.ext.minSdkVersion)
        targetSdkVersion(project.ext.compileSdkVersion)
        versionCode(project.getVersionCode())
        versionName(project.getVersionName())
        multiDexEnabled(true)
        testInstrumentationRunner "androidx.test.runner.AndroidJUnitRunner"
        ndk {
            abiFilters 'armeabi-v7a', 'arm64-v8a', 'x86', 'x86_64', 'armeabi', 'mips'
        }

        splits {
            abi {
                reset()
                include("x86", "x86_64", "armeabi-v7a", "arm64-v8a")
            }
        }
        renderscriptTargetApi 31 //must match target sdk and build tools
        renderscriptSupportModeEnabled true

        setProperty("archivesBaseName", "Alhawanajd")
        signingConfig signingConfigs.release
//        setProperty("archivesBaseName", "Fundoo" + "-v" + versionName)
    }
    tasks.withType(JavaCompile).configureEach{
        options.fork = true
        options.forkOptions.jvmArgs +=[
                '--add-exports=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED',
                '--add-exports=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED',
                '--add-exports=jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED']
    }
    buildFeatures
            {
                viewBinding = true
                dataBinding = true
                buildConfig = true
                compose true
            }
    buildTypes {
        release {
            minifyEnabled false //Important step
            proguardFiles getDefaultProguardFile('proguard-android.txt'), 'proguard-rules.pro'

        }
    }

    dexOptions {
        javaMaxHeapSize "4g"
    }

    configurations {
        all*.exclude group: 'commons-logging', module: 'commons-logging'
        all*.exclude group: 'xpp3', module: 'xpp3'
    }

    // composeOptions is not needed when using the new Kotlin Compose Compiler plugin (2.0.21)
    // The plugin version is managed via libs.plugins.kotlin.compose

    sourceSets {
        main {
            java {
                //Addon - Delete the lines for necessary Addons
                filter.excludes = [
                        "**/addon/chattranslate/**",
                        "**/addon/LanguageTranslationActivity.java",
                        "**/addon/smartreply/**",
                        "**/helper/OnesignalNotificationService.java"
                ]
            }
        }
    }

    android {
        packagingOptions {
            pickFirst 'lib/x86/libc++_shared.so'
            pickFirst 'lib/x86_64/libc++_shared.so'
            pickFirst 'lib/armeabi-v7a/libc++_shared.so'
            pickFirst 'lib/arm64-v8a/libc++_shared.so'
            pickFirst 'lib/arm64-v8a/libavcodec.so'
            pickFirst 'lib/arm64-v8a/libavutil.so'
            pickFirst 'lib/arm64-v8a/libavformat.so'
            pickFirst 'lib/arm64-v8a/libswscale.so'
        }

/** rest of your code here **/
    }

    compileOptions {
        sourceCompatibility JavaVersion.VERSION_17
        targetCompatibility JavaVersion.VERSION_17
    }
    kotlinOptions {
        jvmTarget = "17"
    }
    aaptOptions {
        noCompress "tflite"
    }

    lintOptions {
        quiet true
        abortOnError false
        ignoreWarnings true
        checkReleaseBuilds false
    }
    ndkVersion '22.1.7171670'
    namespace 'com.app.alhawanajd'
}

